# Scheduled Claude jobs are data on the NAS, not lines here: give a spec in
# /srv/jobs/scheduled/<name>.json a "schedule" (5-field cron) and a "tz", and
# cr-schedule queues it (see the header of bin/cr-schedule). This file is
# deployed to EVERY worker, so a per-job line here would queue one copy per
# worker; cr-schedule runs everywhere and claims each slot on the NAS so exactly
# one worker queues it.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Weekly: bring Claude Code up to the current release when the worker is idle
# (cr-update takes the inbox lock, so it never runs under a job; it jitters up to
# 30 min so the fleet does not update in lockstep). Added 2026-10-03 after the
# fleet was found at 2.1.177–2.1.202 with 2.1.289 current — nothing else updates
# a headless runner.
17 4  *   *   0     claude  /opt/claude-runner/bin/cr-update

# Every minute: queue the scheduled jobs that are due (one worker wins each slot).
*  *  *   *   *     claude  /opt/claude-runner/bin/cr-schedule 2>&1 | systemd-cat -t cr-schedule -p notice
