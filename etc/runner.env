# Claude runner config (non-secret). Sourced by run-job.
# MANAGED BY bullpen gitops (lentago/bullpen) — edits on a worker are overwritten
# from main on the next pull. Change it in the repo, not on the box.
# Default model for jobs that don't specify one (blank = account default).
CLAUDE_RUNNER_MODEL=
# Default working directory for jobs.
CLAUDE_RUNNER_CWD=/home/claude/work
# Per-job bounds (issue #114). Each is overridable per job spec (max_turns,
# max_budget_usd, timeout_sec) or project registry entry; most-specific wins, like
# model. Blank = uncapped. Picked from the logs/*.meta ledger (434 jobs to
# 2026-10-04: p90 48 turns / $3.78 / 640s; max 170 / $25.72 / 4,277s) so each
# would have cut only the single worst historical run. Revisit after a month.
# A hit lands the job in failed/ with limit=turns|budget|timeout in its .meta.
CLAUDE_RUNNER_MAX_TURNS=150
CLAUDE_RUNNER_MAX_BUDGET_USD=15
# Wall clock: TERM at this many seconds, KILL 30s later (exit 7, limit=timeout).
CLAUDE_RUNNER_TIMEOUT_SEC=3600
# Capture each job's full reasoning transcript (thinking + tool calls) to
# logs/<runid>.transcript.jsonl on the NAS. Set 0 to disable (saves space).
CLAUDE_RUNNER_CAPTURE_TRANSCRIPT=1

# Metrics: per-job events POSTed here (Alloy Loki receiver on LXC 105 -> Grafana Cloud).
LOKI_PUSH_URL=http://192.168.139.20:3100/loki/api/v1/push
