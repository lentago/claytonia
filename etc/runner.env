# Claude runner config (non-secret). Sourced by run-job.
# MANAGED BY claytonia gitops (lentago/claytonia) — edits on a worker are overwritten
# from main on the next pull. Change it in the repo, not on the box.
# Default runtime for jobs whose spec and project name none (#168): the adapter
# bin/rt-<runtime> that run-job reaches the agent CLI through. A registry entry with
# no runtime runs on this, and its model (a Claude model) applies only while this is claude.
CLAUDE_RUNNER_RUNTIME=claude
# Default model for jobs that don't specify one (blank = the runtime's default).
# It is written for CLAUDE_RUNNER_RUNTIME and applies only to jobs on that runtime.
CLAUDE_RUNNER_MODEL=
# Default working directory for jobs.
CLAUDE_RUNNER_CWD=/home/claude/work
# Per-job bounds (issue #114). Each is overridable per job spec (max_turns,
# max_budget_usd, timeout_sec) or project registry entry; most-specific wins, like
# model. Blank = uncapped. Picked from the logs/*.meta ledger (434 jobs to
# 2026-10-04: p90 48 turns / $3.78 / 640s; max 170 / $25.72 / 4,277s) so each
# would have cut only the single worst historical run. Revisit after a month.
# A hit lands the job in failed/ with limit=turns|budget|timeout in its .meta.
CLAUDE_RUNNER_MAX_TURNS=150
CLAUDE_RUNNER_MAX_BUDGET_USD=15
# Wall clock: TERM at this many seconds, KILL 30s later (exit 7, limit=timeout).
CLAUDE_RUNNER_TIMEOUT_SEC=3600
# Capture each job's full reasoning transcript (thinking + tool calls) to
# logs/<runid>.transcript.jsonl on the NAS. Set 0 to disable (saves space).
CLAUDE_RUNNER_CAPTURE_TRANSCRIPT=1

# Metrics: per-job events POSTed here (Alloy Loki receiver on LXC 105 -> Grafana Cloud).
LOKI_PUSH_URL=http://192.168.139.20:3100/loki/api/v1/push

# Optional (#128): Grafana base URL (no secrets). When set, the issue claim comment links
# "<url>/d/claude-runner-fleet?var-runid=<runid>" (runid variable: drosera#235). Blank = no link.
CLAUDE_RUNNER_GRAFANA_URL=https://lentago.grafana.net

# Peer-runtime CLI versions (#172): the weekly cr-update brings each worker's Gemini
# CLI and Codex CLI to exactly these (an exact version, or "latest"; blank = leave the
# CLI as it is). Claude Code needs no pin: it follows its own release channel. Bump a
# pin in a reviewed PR, after re-checking what the adapter relies on in the new release
# (bin/rt-gemini and bin/rt-codex, header "update"), recapturing the test fixtures, and
# re-running the live gate jobs. 0.66.0 and 0.166.0 are what the Phase 1 gate ran.
CLAUDE_RUNNER_GEMINI_VERSION=0.66.0
CLAUDE_RUNNER_CODEX_VERSION=0.166.0
