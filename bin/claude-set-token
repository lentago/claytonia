#!/usr/bin/env bash
# claude-set-token — store the OAuth token from `claude setup-token` securely.
# Run `claude setup-token` first, copy the printed token, then run this as root and
# paste it: `ssh root@<worker> claude-set-token`. The agent user has no sudo beyond
# the token broker (#177), so this no longer goes through sudo.
set -euo pipefail
DEST=/etc/claude-runner/token.env
[ "$EUID" -eq 0 ] || { echo "claude-set-token: run as root (ssh root@<worker> claude-set-token)" >&2; exit 1; }
printf 'Paste the OAuth token from `claude setup-token`, then Enter: ' >&2
read -rs TOKEN; echo >&2
[ -n "$TOKEN" ] || { echo "no token provided" >&2; exit 1; }
umask 077
printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$TOKEN" > "$DEST"
chown root:claude "$DEST"; chmod 640 "$DEST"
echo "stored in $DEST (root:claude 640), token length ${#TOKEN}" >&2
