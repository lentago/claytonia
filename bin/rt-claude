#!/usr/bin/env bash
# rt-claude — the Claude Code runtime adapter (#166, #167).
#
# run-job drives every agent runtime through one adapter, bin/rt-<runtime>, and
# three subcommands. This is the contract a second runtime is built against:
#
#   rt-<runtime> run --cwd DIR --runid ID --session-id UUID [--model M]
#                    [--max-turns N] [--max-budget-usd X] [--allowed-tools T]
#       Run the agent headless. run-job has already cd'd to DIR; the prompt is on
#       stdin (never argv: one argv string caps at 128 KiB); the runtime's raw
#       output goes to stdout, which run-job files byte-for-byte as
#       logs/<runid>.json; diagnostics go to stderr (logs/<runid>.stderr).
#       run-job's timeout(1) wraps this call and signals its process group, so
#       the adapter must neither outlive nor swallow TERM.
#   rt-<runtime> normalize --raw F --result F --txt F --session-id UUID [--model M]
#       Turn the raw output into the normalized result (F of --result, filed as
#       logs/<runid>.result.json) and the final text (--txt, logs/<runid>.txt).
#       Called after the run and outside the timeout, so a killed run is still
#       filed. Raw output that is not JSON gets no result: run-job then lets the
#       exit code alone decide, as it always has. Exits non-zero only when the
#       output was readable but its result could not be written; run-job then
#       fails the job (fail closed: a run whose result is lost is never filed as
#       a success). Silent on stderr, because the last line of run-job's stderr
#       log is what a failure comment quotes.
#   rt-<runtime> transcript --session-id UUID --out F
#       Best-effort: copy the session transcript, if the runtime keeps one.
#   rt-<runtime> accepts-model --model M
#       Exit 0 when M is a model this runtime takes, 1 when it is not. run-job asks
#       only about a model the job spec names, and refuses the job at claim time
#       on a 1 (#168). Each adapter owns its own rule; none knows another's.
#   rt-<runtime> enforces --limit turns|budget
#       Exit 0 when this runtime enforces that cap itself (max_turns, max_budget_usd),
#       1 when it does not; 2 for any other limit name. run-job asks only about a
#       limit the job sets, and records the answer in the .meta as
#       turns_enforced= / budget_enforced= yes|no (#173). The wall clock is not
#       asked about: timeout(1) enforces it outside every adapter.
#
# Normalized result:
#   {runtime, model, session_id, status, is_error, turns,
#    tokens: {in, cached, cache_write, out, thinking},
#    tokens_by_model: {"<model id>": {in, cached, cache_write, out, thinking}},
#    cost_usd, final_text}
#   status    ok | max_turns | max_budget | error. run-job maps max_turns and
#             max_budget to limit=turns|budget and fails any status but ok.
#   is_error  the runtime itself reported the run as failed; run-job sets exit 1.
#   tokens    five disjoint counts (#173); each input token is in exactly one of
#             in (the uncached rate), cached (cache reads) and cache_write (cache
#             writes); out excludes thinking when the runtime reports thinking
#             separately, else thinking is null. A count the runtime does not
#             report is null; all five are null when it reported no usage.
#   tokens_by_model
#             the same five counts per model the run used, which sum to `tokens`
#             field by field. Keyed "unknown" when the runtime reports usage but
#             not which model it was; null exactly when all of `tokens` is null.
#   cost_usd  as the runtime reports it; null when it reports none (never 0).
#
# For Claude: `run` is the exact command run-job ran before the seam existed, and
# it execs the CLI so the process tree under timeout(1) is unchanged.
set -uo pipefail
CLAUDE_BIN="${CLAUDE_BIN:-/home/claude/.local/bin/claude}"
# The Claude token (root:claude 0640). Only `run` reads it, just before it execs
# the CLI; run-job holds no vendor secret (#170).
TOKEN_ENV="${CLAUDE_RUNNER_TOKEN_ENV:-/etc/claude-runner/token.env}"

usage() { echo "usage: rt-claude run|normalize|transcript|accepts-model|enforces [options]  (see the header)" >&2; exit 2; }

cmd="${1:-}"; [ -n "$cmd" ] || usage; shift
cwd=""; runid=""; sid=""; model=""; max_turns=""; max_budget=""; allowed=""
raw=""; result=""; txt=""; out=""; limit=""
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || { echo "rt-claude: $1 needs a value" >&2; exit 2; }
  case "$1" in
    --cwd)            cwd="$2" ;;
    --runid)          runid="$2" ;;
    --session-id)     sid="$2" ;;
    --model)          model="$2" ;;
    --max-turns)      max_turns="$2" ;;
    --max-budget-usd) max_budget="$2" ;;
    --allowed-tools)  allowed="$2" ;;
    --raw)            raw="$2" ;;
    --result)         result="$2" ;;
    --txt)            txt="$2" ;;
    --out)            out="$2" ;;
    --limit)          limit="$2" ;;
    *) echo "rt-claude: unknown option $1" >&2; exit 2 ;;
  esac
  shift 2
done

case "$cmd" in
  run)
    args=( -p --dangerously-skip-permissions --output-format json --session-id "$sid" )
    [ -n "$model" ]      && args+=( --model "$model" )
    [ -n "$max_turns" ]  && args+=( --max-turns "$max_turns" )
    [ -n "$max_budget" ] && args+=( --max-budget-usd "$max_budget" )
    [ -n "$allowed" ]    && args+=( --allowedTools "$allowed" )
    # <sid>.runid sidecar next to the live transcript, so the worker Alloy can
    # attach a runid label to the transcript stream without waiting for the run
    # to end. The directory name mirrors Claude Code's cwd encoding (/ → -).
    _sid_projdir="$HOME/.claude/projects/$(printf '%s' "$cwd" | tr '/' '-')"
    mkdir -p "$_sid_projdir" 2>/dev/null || true
    printf '%s\n' "$runid" > "$_sid_projdir/${sid}.runid" 2>/dev/null || true
    # shellcheck source=/dev/null
    [ -f "$TOKEN_ENV" ] && . "$TOKEN_ENV"
    export CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}"
    exec "$CLAUDE_BIN" "${args[@]}"
    ;;

  normalize)
    [ -n "$raw" ] && [ -n "$result" ] && [ -n "$txt" ] || usage
    rm -f "$result" 2>/dev/null
    if ! jq -e . "$raw" >/dev/null 2>&1; then
      cp "$raw" "$txt" 2>/dev/null || true
      exit 0
    fi
    { jq -r '.result // .text // ""' "$raw" > "$txt"; } 2>/dev/null || true
    # Field values are copied, never recomputed, so run-job reads back exactly
    # the strings it used to read from the raw JSON (cost and turns land in the
    # .meta as-is). The braces keep a failed redirect's shell message off stderr.
    if { jq -c --arg model "$model" --arg sid "$sid" '
      def str: if . == null then "" else tostring end;
      def num: if type == "number" then . else error("not a number") end;
      def none5: {in: null, cached: null, cache_write: null, out: null, thinking: null};
      def sum5: {in: (map(.in) | add), cached: (map(.cached) | add),
                 cache_write: (map(.cache_write) | add), out: (map(.out) | add), thinking: null};
      # Claude reports cache writes and cache reads apart from input, and folds
      # thinking into output, so thinking is null. modelUsage is the whole session,
      # every model and subagent (its costUSD sums to total_cost_usd); .usage covers
      # only part of it, so it is read only when modelUsage is missing, and its
      # model is unknown. A malformed modelUsage yields null counts, never the
      # partial .usage counts passed off as the session. A malformed block never
      # costs the job its result. (No apostrophes here: this is a quoted jq program.)
      def per_model: {in: (.inputTokens | num), cached: (.cacheReadInputTokens // 0 | num),
                      cache_write: (.cacheCreationInputTokens // 0 | num),
                      out: (.outputTokens | num), thinking: null};
      def from_usage: .usage | if type == "object" then . else error("no usage") end
        | {in: (.input_tokens | num), cached: (.cache_read_input_tokens // 0 | num),
           cache_write: (.cache_creation_input_tokens // 0 | num),
           out: (.output_tokens | num), thinking: null};
      def by_model:
        if (.modelUsage | type) == "object" and (.modelUsage | length) > 0
        then (try (.modelUsage | with_entries(.value = (.value | per_model))) catch null)
        else (try {unknown: from_usage} catch null) end;
      if type != "object" then
        {runtime: "claude", model: (if $model == "" then null else $model end),
         session_id: $sid, status: "ok", is_error: false, turns: null,
         tokens: none5, tokens_by_model: null,
         cost_usd: null, final_text: null}
      else
        (.subtype | str) as $sub
        | (((.is_error // false) | str) == "true") as $err
        | by_model as $tbm
        | {runtime: "claude",
           model: (if $model == "" then null else $model end),
           session_id: (if $sid == "" then .session_id else $sid end),
           status: (if $sub == "error_max_turns" then "max_turns"
                    elif $sub == "error_max_budget_usd" then "max_budget"
                    elif ($sub | startswith("error_")) or $err then "error"
                    else "ok" end),
           is_error: $err,
           turns: .num_turns,
           tokens: (if $tbm == null then none5 else ([$tbm[]] | sum5) end),
           tokens_by_model: $tbm,
           cost_usd: .total_cost_usd,
           final_text: (.result // .text // "")}
      end' "$raw" > "$result.tmp"; } 2>/dev/null
    then
      if [ -s "$result.tmp" ]; then
        mv -f "$result.tmp" "$result" 2>/dev/null || { rm -f "$result.tmp" 2>/dev/null; exit 1; }
      else
        rm -f "$result.tmp" 2>/dev/null   # jq 1.6 passes `jq -e .` on empty output (a killed run): no result is due
      fi
    else
      # Parseable output, but no result could be written: say so, and run-job
      # fails the job rather than file a run it cannot read as a success.
      rm -f "$result.tmp" 2>/dev/null; exit 1
    fi
    exit 0
    ;;

  accepts-model)
    # The Claude CLI's own aliases (optionally with its [1m] context suffix) and
    # full claude-* model ids. Every model a fleet job has named to date is one.
    base="${model%"[1m]"}"
    case "$base" in
      haiku|sonnet|opus|fable|opusplan|default|claude-*) exit 0 ;;
      *) exit 1 ;;
    esac
    ;;

  enforces)
    # Both caps are native: run passes --max-turns and --max-budget-usd to the CLI.
    case "$limit" in
      turns|budget) exit 0 ;;
      *) usage ;;
    esac
    ;;

  transcript)
    # Claude Code writes the full session (assistant messages, thinking, tool calls
    # and results) under ~/.claude/projects/<cwd-encoded>/<session-id>.jsonl.
    [ -n "$sid" ] && [ -n "$out" ] || usage
    tpath="$(find "$HOME/.claude/projects" -name "${sid}.jsonl" -print -quit 2>/dev/null)"
    [ -n "$tpath" ] && cp -f "$tpath" "$out" 2>/dev/null
    exit 0
    ;;

  *) usage ;;
esac
