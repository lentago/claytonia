#!/usr/bin/env bash
# ledger-report — read-only visibility layer for the myosotis context ledger.
# See docs/context-ledger.md § ledger-report.
#
# Usage:
#   ledger-report                              fleet summary
#   ledger-report --host <h> [--since <age>]   host drift commits + file lists
#   ledger-report --host <h> --diff [--since <age>]  actual diffs
#   ledger-report --quarantines                quarantine history
#   ledger-report --fetch                      git fetch before reporting
#
# Age shorthands for --since: 7d, 2w, 1m, 12h.  Git date strings also accepted.
# Env overrides: LEDGER_CLONE_DIR  LEDGER_DEPLOY_KEY
set -uo pipefail
export LC_ALL=C

LEDGER_CLONE_DIR="${LEDGER_CLONE_DIR:-/opt/context-ledger/myosotis}"
LEDGER_DEPLOY_KEY="${LEDGER_DEPLOY_KEY:-/root/.ssh/myosotis_deploy}"

MODE="summary"
HOST=""
SINCE_RAW=""
DO_FETCH=0

die() { printf 'ledger-report: %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --host)        [ $# -gt 1 ] || die "--host requires an argument"; shift; HOST="$1" ;;
    --host=*)      HOST="${1#--host=}" ;;
    --since)       [ $# -gt 1 ] || die "--since requires an argument"; shift; SINCE_RAW="$1" ;;
    --since=*)     SINCE_RAW="${1#--since=}" ;;
    --diff)        MODE="diff" ;;
    --quarantines) MODE="quarantines" ;;
    --fetch)       DO_FETCH=1 ;;
    *)             die "unknown option: $1" ;;
  esac
  shift
done

[ -n "$HOST" ] && [ "$MODE" = "summary" ] && MODE="host"
[ "$MODE" = "diff" ] && [ -z "$HOST" ] && die "--diff requires --host"

# Normalise --since shorthands: 7d -> "7 days ago", 2w -> "2 weeks ago", etc.
SINCE_GIT=""
if [ -n "$SINCE_RAW" ]; then
  case "$SINCE_RAW" in
    *d) SINCE_GIT="${SINCE_RAW%d} days ago" ;;
    *w) SINCE_GIT="${SINCE_RAW%w} weeks ago" ;;
    *m) SINCE_GIT="${SINCE_RAW%m} months ago" ;;
    *h) SINCE_GIT="${SINCE_RAW%h} hours ago" ;;
    *)  SINCE_GIT="$SINCE_RAW" ;;
  esac
fi

[ -d "$LEDGER_CLONE_DIR/.git" ] || die "no ledger clone at $LEDGER_CLONE_DIR"

# --- optional fetch (only mutating git op this script ever performs) ----------
if [ "$DO_FETCH" -eq 1 ]; then
  if [ -f "$LEDGER_DEPLOY_KEY" ]; then
    GIT_SSH_COMMAND="ssh -i $LEDGER_DEPLOY_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new" \
      git -C "$LEDGER_CLONE_DIR" fetch --quiet origin || die "fetch failed"
  else
    git -C "$LEDGER_CLONE_DIR" fetch --quiet origin || die "fetch failed"
  fi
fi

since_flag=()
[ -n "$SINCE_GIT" ] && since_flag=("--since=$SINCE_GIT")

# --- summary -----------------------------------------------------------------
if [ "$MODE" = "summary" ]; then
  shopt -s nullglob
  dirs=("$LEDGER_CLONE_DIR"/hosts/*)
  if [ "${#dirs[@]}" -eq 0 ]; then
    printf '(no hosts in ledger)\n'
    exit 0
  fi
  now="$(date +%s)"
  printf '%-20s  %-32s  %-6s  %s\n' HOST "LAST SNAPSHOT (UTC)" AGE STATUS
  printf '%-20s  %-32s  %-6s  %s\n' '----' '-------------------' '---' '------'
  for d in "${dirs[@]}"; do
    h="$(basename "$d")"
    hp="hosts/$h"
    last_ct="$(git -C "$LEDGER_CLONE_DIR" log -1 --format='%ct' -- "$hp")"
    last_ci="$(git -C "$LEDGER_CLONE_DIR" log -1 --format='%ci' -- "$hp")"
    last_h="$(git  -C "$LEDGER_CLONE_DIR" log -1 --format='%h'  -- "$hp")"
    n_files=0
    [ -n "$last_h" ] && n_files="$(git -C "$LEDGER_CLONE_DIR" diff-tree \
      --root --no-commit-id -r --name-only "$last_h" -- "$hp" 2>/dev/null | wc -l | tr -d ' ')"
    status="unknown"
    meta="$d/meta.json"
    [ -f "$meta" ] && status="$(jq -r '.status // "unknown"' "$meta" 2>/dev/null || printf 'unknown')"
    [ -f "$d/QUARANTINE.txt" ] && status="quarantined"
    age="?"
    if [ -n "$last_ct" ]; then
      diff_s=$(( now - last_ct ))
      if   [ "$diff_s" -lt 3600  ]; then age="${diff_s}s"
      elif [ "$diff_s" -lt 86400 ]; then age="$(( diff_s/3600 ))h"
      else                               age="$(( diff_s/86400 ))d"
      fi
      [ "$status" = "ok" ] && [ "$diff_s" -gt 172800 ] && status="stale"
    fi
    printf '%-20s  %-32s  %-6s  %s  (%s files, %s)\n' \
      "$h" "$last_ci" "$age" "$status" "$n_files" "$last_h"
  done
  exit 0
fi

# --- quarantines -------------------------------------------------------------
if [ "$MODE" = "quarantines" ]; then
  shopt -s nullglob
  found=0
  for d in "$LEDGER_CLONE_DIR"/hosts/*/; do
    h="$(basename "${d%/}")"
    hp="hosts/$h"
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      hash="${line%% *}"
      rest="${line#* }"
      printf 'commit %s  %s\n' "$hash" "$rest"
      printf '  host: %s\n' "$h"
      git -C "$LEDGER_CLONE_DIR" show "$hash:$hp/QUARANTINE.txt" 2>/dev/null | sed 's/^/  /'
      printf '\n'
      found=$(( found + 1 ))
    done < <(git -C "$LEDGER_CLONE_DIR" log --format='%H %ci %s' -- "$hp/QUARANTINE.txt")
  done
  [ "$found" -eq 0 ] && printf '(no quarantines in history)\n'
  exit 0
fi

# --- host / diff -------------------------------------------------------------
hp="hosts/$HOST"
[ -d "$LEDGER_CLONE_DIR/$hp" ] || die "host '$HOST' not found in ledger"

if [ "$MODE" = "diff" ]; then
  git -C "$LEDGER_CLONE_DIR" log -p "${since_flag[@]}" -- "$hp"
else
  git -C "$LEDGER_CLONE_DIR" log --format='%H %ci %s' "${since_flag[@]}" -- "$hp" |
  while IFS= read -r line; do
    hash="${line%% *}"
    rest="${line#* }"
    printf 'commit %s  %s\n' "$hash" "$rest"
    git -C "$LEDGER_CLONE_DIR" diff-tree --root --no-commit-id -r --name-only "$hash" -- "$hp" | sed 's/^/  /'
    printf '\n'
  done
fi
