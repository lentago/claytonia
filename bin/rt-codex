#!/usr/bin/env bash
# rt-codex — the Codex CLI runtime adapter (#166, #171).
#
# The contract (subcommands, arguments, the normalized result) is in the rt-claude
# header; this adapter implements it for Codex CLI 0.166 (`codex exec --json`). It is
# inert until a job resolves runtime=codex (spec, registry or CLAUDE_RUNNER_RUNTIME).
#
# run — the command:
#   codex exec --json -C <cwd> --dangerously-bypass-approvals-and-sandbox
#     --ignore-user-config -c forced_login_method="api"
#     -c project_doc_fallback_filenames=["CLAUDE.md"]
#     [-c shell_environment_policy.set.GH_TOKEN_ACCESS="<profile>"]
#     -o <cache>/<session-id>.last-message [-m <model>] [--skip-git-repo-check]
#   The prompt is on stdin (with no PROMPT argument, exec reads stdin), and the CLI is
#   exec'd, so the process tree under run-job's timeout(1) is the CLI alone.
#   --skip-git-repo-check goes only to a cwd that is not a git work tree (ad-hoc jobs).
#   exec's one trust gate is "Not inside a trusted directory and --skip-git-repo-check
#   was not specified" (0.166's own message), and a fresh checkout is a repo, so it
#   needs no trust entry; an untrusted repo's .codex/ config and hooks stay unloaded.
#   Codex's default shell environment policy drops every *KEY* and *TOKEN* variable
#   from the agent's commands (0.166's defaults, read from the binary). That keeps
#   CODEX_API_KEY out of them, but it also drops GH_TOKEN_ACCESS, the profile
#   gh-credential-helper mints for (#176); the `set` override puts that one back.
#
# Auth (judgment B): `run` sources /etc/claude-runner/codex.env (root:claude 0640,
#   installed by hand; CLAUDE_RUNNER_CODEX_ENV overrides the path, like rt-claude's
#   CLAUDE_RUNNER_TOKEN_ENV) for the key the file names OPENAI_API_KEY, and hands it
#   to the CLI renamed as CODEX_API_KEY (below), just before it execs the CLI; run-job
#   holds no vendor secret (#170). A missing or unreadable file, or one that sets no
#   key, is one stderr line and exit 78 (EX_CONFIG) before the CLI starts. The file's
#   own output is discarded, so a malformed line never echoes the key. Every
#   assignment in it is exported, so it may also set OPENAI_BASE_URL or
#   OPENAI_ORGANIZATION on purpose; ambient values of those, of the workload-identity
#   variables (OPENAI_FEDERATION_RULE_ID, OPENAI_IDENTITY_TOKEN_FILE,
#   OPENAI_WORKLOAD_IDENTITY_CONTEXT) and of the other auth variables are cleared
#   first, so nothing in run-job's environment can redirect auth or the endpoint.
#   CODEX_HOME is pinned to ~/.codex, so an ambient one cannot bring another login or
#   config. `run` creates it (0700) when it is missing, as on a freshly built worker,
#   because 0.166 will not start without it; a home it cannot create or write is one
#   stderr line and exit 78 before the CLI starts.
#   The file names the key OPENAI_API_KEY (its name in OpenAI's console and in
#   README § Auth), but `codex exec` 0.166 reads an API key from the environment only
#   as CODEX_API_KEY. OPENAI_API_KEY is just what `codex login --with-api-key` reads
#   on stdin. So `run` hands the key to the CLI as CODEX_API_KEY and unsets
#   OPENAI_API_KEY. Checked live on claude-runner-3 (#171, 2026-11-04): with only
#   OPENAI_API_KEY set, every request is "401 Unauthorized: Missing bearer or basic
#   authentication in header"; with only CODEX_API_KEY it answers. The bats test
#   checks the rename against a stub, so a Codex update must re-check the name live
#   (#172). CODEX_ACCESS_TOKEN
#   and the Claude and Gemini credentials are unset too, so the key is the only
#   credential in the CLI's environment (its doctor warns when several auth variables
#   are set). forced_login_method="api" makes Codex refuse ChatGPT auth ("API key
#   login is required, but ChatGPT is currently being used. Logging out."), so a
#   cached login is never what authenticates.
#   The key is not a secret from the agent. The agent runs as `claude`, which must
#   read codex.env for the CLI to start, so a job can read the file (as it can
#   token.env for Claude), sandbox or not. The shell policy above keeps the key out
#   of the agent's commands' environment, not out of its reach. This is #166's
#   accepted consequence (Secrets; ADR-0010's trade-off): any job on any worker can
#   spend against the key, and the key's own project scope and usage limits are
#   what bound the damage.
#
# Context: --ignore-user-config skips ~/.codex/config.toml, so nothing on a worker
#   (an MCP server, a model, a profile) changes a fleet run and nothing needs baking:
#   every setting is a -c override above. project_doc_fallback_filenames loads the
#   repo CLAUDE.md when the repo has no AGENTS.md (checked on 0.166: `codex debug
#   prompt-input` in a repo holding only CLAUDE.md includes it with the override and
#   omits it without).
#
# Sandbox verification (#171; CT 117 claude-runner-5, codex-cli 0.166.0, 2026-11-04).
#   `codex sandbox -P <profile> -C <dir> -- <cmd>` runs one command under the sandbox
#   with no model and no auth. 0.166's Linux sandbox is bubblewrap (vendored) plus a
#   seccomp filter; Landlock is a deprecated opt-in.
#   - It starts in the unprivileged LXC. Inside: uid_map "1000 0 1", Seccomp 2,
#     NoNewPrivs 1, CapEff 0.
#   - :workspace enforces its policy: writes in the workspace and /tmp succeed; $HOME,
#     an extra root and any other path are a read-only file system; the network is
#     off (DNS fails). A profile extending :workspace with a filesystem write grant
#     and network={enabled=true} writes the extra root and reaches GitHub (curl
#     api.github.com: 200; git ls-remote works). The legacy keys #171's command used,
#     sandbox_workspace_write.writable_roots and .network_access, changed neither.
#   - Two findings rule the sandbox out for fleet jobs:
#     1. .git is read-only under :workspace, so `git commit` fails on index.lock
#        unless the profile grants <cwd>/.git (with the grant it works).
#     2. no_new_privs stops sudo: "The 'no new privileges' flag is set, which prevents
#        sudo from running as root". gh-token reaches the App key only through its
#        one sudoers rule (#177), so under the sandbox gh-credential-helper cannot
#        mint: `git push` and the preamble's gh re-auth would both fail.
#   Verdict, per #171 step 2: --dangerously-bypass-approvals-and-sandbox (it also
#   means approval never), the posture rt-claude runs with
#   (--dangerously-skip-permissions) on a worker that is itself the sandbox. With no
#   sandbox, --add-dir and sandbox_workspace_write.* would widen nothing, so they are
#   not passed. A sandboxed Codex needs a token path that runs no sudo inside the run.
#   Not yet exercised: a real `codex exec` (no key is installed anywhere). The first
#   live jobs confirm auth, the CLAUDE.md load, git push and gh pr create end to end.
#
# normalize: --raw is the JSONL event stream. Lines that are not JSON objects are
#   skipped, so a run killed mid-line still files what it printed; no events at all
#   is no result (the exit code decides, as the contract says).
#   session_id  thread.started.thread_id. Codex mints its own and cannot take run-job's
#               UUID; --session-id stands in only when no thread started.
#   final_text  the -o file, else the last item.completed agent_message.
#   status      ok when a turn completed, none failed and there is a final message;
#               else error. The exit code is not visible here; run-job fails a
#               non-zero exit whatever the status says.
#   is_error    a turn.failed, or an error event with no completed turn.
#   turns       completed action items: every item.completed whose type is not
#               agent_message, reasoning, todo_list or error (command_execution,
#               file_change, mcp_tool_call, web_search, …). An exec run is usually
#               one model turn, so this counts what the run did instead.
#   tokens      turn.completed usage, summed, per #173. OpenAI counts cached reads
#               and cache writes inside input_tokens, and reasoning inside
#               output_tokens, so in = input - cached_input - cache_write_input,
#               cached = cached_input, cache_write = cache_write_input,
#               out = output - reasoning_output, thinking = reasoning_output. Each
#               input token bills at exactly one of the three input rates. Usage
#               whose parts exceed its whole (a negative in or out) is inconsistent:
#               all five are null, never a negative count priced as one.
#   tokens_by_model
#               every token under one model: the `model` of the session
#               transcript's turn_context lines (exec --json names none, and its
#               usage records carry none). "unknown" when the transcript is missing,
#               names no model, or names several (the tokens cannot be split
#               between them, and are never priced at a guess).
#   cost_usd    null: Codex reports none; drosera prices tokens.
#
# Where the -o file lives: normalize gets no runid, but run and normalize both get
#   --session-id (run-job's UUID for this run). So the last message goes to
#   ${XDG_CACHE_HOME:-$HOME/.cache}/rt-codex/<session-id>.last-message, outside any
#   checkout. normalize reads it, falls back to the raw stream when it is missing (a
#   killed run, an unwritable cache), deletes it, and leaves <session-id>.thread
#   holding the Codex thread id for `transcript`, which run-job also calls with its
#   own UUID. Each run prunes files there older than two days.
#
# about (#174): lentago/.github ADR-0015's row for Codex: Codex CLI, its repository,
#   and the trailer GitHub links to codex, OpenAI's account.
#
# live-session (#239): the same session file while the run is live, printed with
#   Codex's thread id, which the thread.started event announces as the first line of
#   the run's raw output (--raw, logs/<runid>.json as written so far). Nothing until
#   that event and the file both exist. run-job links it for the transcript shipper
#   (drosera ADR-0012).
#
# transcript: copies ~/.codex/sessions/**/*<thread id>.jsonl (the pinned CODEX_HOME)
#   as-is (normalize reads its turn_context for the model, above). Best-effort;
#   a --session-id with no thread recorded is tried as a thread id itself.
#
# accepts-model: OpenAI model ids Codex takes: gpt-*, codex-* and the o-series (o3,
#   o4-mini, …), in lowercase letters, digits, '.' and '-'. Claude and Gemini names,
#   and Claude's aliases, are refused.
#
# update (#172): brings the openai/codex release package to CLAUDE_RUNNER_CODEX_VERSION
#   from etc/runner.env. That is an exact version, or `latest`; unset leaves the CLI
#   as it is. The layout is kalmia's runner image's (forge/runner/substrate.sh), all
#   root-owned: /opt/codex/<version>, /opt/codex/current pointing at it, and
#   /usr/local/bin/codex linking to current/bin/codex. A version not yet on disk is
#   downloaded from the GitHub release, checked against the sha256 digest GitHub
#   publishes for the asset, checked for the package layout, and unpacked beside
#   the others. Then `current` moves to it. The digest comes from the same release
#   API as the asset, so it catches a corrupt or truncated download. The release's
#   authenticity rests on GitHub over TLS, as it does for the image's own install.
#   Older versions stay on disk, so a rollback is a pin change. An exact pin that is
#   already on disk, running or not, needs no network. Only an update that is due
#   needs root: a layout this user cannot
#   write is exit 4. A pin bump is a reviewed PR because this adapter rests on
#   0.166 facts a new release can change: the CODEX_API_KEY name, the exec --json
#   events, the turn_context model. Recapture the fixtures and re-run the live gate
#   jobs before bumping.
#
# Limits: Codex has no native turn or budget cap and no tool allowlist. When
#   --max-turns, --max-budget-usd or --allowed-tools is set, `run` writes one stderr
#   line naming what is not enforced, and `enforces` answers no for both, so run-job
#   records turns_enforced=no and budget_enforced=no in the .meta of a job that sets
#   them (#173). The wall clock (run-job's timeout(1)) applies as for every runtime;
#   a Codex job's spend is bounded only by it and by the usage limit on the key's
#   OpenAI project.
set -uo pipefail
CODEX_BIN="${CODEX_BIN:-/usr/local/bin/codex}"
STATE="${XDG_CACHE_HOME:-${HOME:-/home/claude}/.cache}/rt-codex"
# Codex's home is pinned: an ambient CODEX_HOME could hold another login or config.
CODEX_DIR="${HOME:-/home/claude}/.codex"
EX_CONFIG=78
# The installed layout `update` manages, and where it finds releases (test seams).
CODEX_ROOT="${CODEX_ROOT:-/opt/codex}"
CODEX_LINK="${CODEX_LINK:-$CODEX_BIN}"
CODEX_RELEASES_API="${CODEX_RELEASES_API:-https://api.github.com/repos/openai/codex/releases}"
CODEX_ASSET=codex-package-x86_64-unknown-linux-musl.tar.gz

usage() { echo "usage: rt-codex run|normalize|transcript|accepts-model|enforces|update|live-session|about [options]  (see the header)" >&2; exit 2; }

cmd="${1:-}"; [ -n "$cmd" ] || usage; shift
cwd=""; sid=""; model=""; max_turns=""; max_budget=""; allowed=""
raw=""; result=""; txt=""; out=""; limit=""
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || { echo "rt-codex: $1 needs a value" >&2; exit 2; }
  case "$1" in
    --cwd)            cwd="$2" ;;
    --runid)          ;;   # part of the contract; Codex keys nothing on it
    --session-id)     sid="$2" ;;
    --model)          model="$2" ;;
    --max-turns)      max_turns="$2" ;;
    --max-budget-usd) max_budget="$2" ;;
    --allowed-tools)  allowed="$2" ;;
    --raw)            raw="$2" ;;
    --result)         result="$2" ;;
    --txt)            txt="$2" ;;
    --out)            out="$2" ;;
    --limit)          limit="$2" ;;
    *) echo "rt-codex: unknown option $1" >&2; exit 2 ;;
  esac
  shift 2
done

# The per-run file stem in $STATE: the session id, reduced to a safe file name.
key="$(printf '%s' "$sid" | tr -cd 'A-Za-z0-9_-')"

# session_file <thread id> — the session transcript Codex keeps for that thread
# under the pinned home, or nothing. Only a UUID is matched against file names:
# anything shorter could suffix-match another session's file.
session_file() {
  [[ "$1" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] || return 0
  find "$CODEX_DIR/sessions" -type f -name "*${1}.jsonl" -print -quit 2>/dev/null
}

case "$cmd" in
  run)
    envf="${CLAUDE_RUNNER_CODEX_ENV:-/etc/claude-runner/codex.env}"
    if [ ! -r "$envf" ]; then
      echo "rt-codex: cannot read $envf, which holds OPENAI_API_KEY for Codex jobs (judgment B, #171)" >&2
      exit "$EX_CONFIG"
    fi
    # Whatever steers Codex's auth or endpoint comes from codex.env or from nowhere:
    # nothing ambient survives into the CLI.
    unset OPENAI_API_KEY CODEX_API_KEY CODEX_ACCESS_TOKEN OPENAI_BASE_URL OPENAI_ORGANIZATION \
          OPENAI_FEDERATION_RULE_ID OPENAI_IDENTITY_TOKEN_FILE OPENAI_WORKLOAD_IDENTITY_CONTEXT
    set +u; set -a
    # shellcheck source=/dev/null
    . "$envf" >/dev/null 2>&1   # silenced: an error line would quote the key
    set +a; set -u
    if [ -z "${OPENAI_API_KEY:-}" ]; then
      echo "rt-codex: $envf sets no OPENAI_API_KEY (judgment B, #171)" >&2
      exit "$EX_CONFIG"
    fi
    # exec reads an API key from the environment only as CODEX_API_KEY (header, Auth),
    # so the key moves there. One key, API-key auth only, no other runtime's credential.
    export CODEX_API_KEY="$OPENAI_API_KEY"
    unset OPENAI_API_KEY CODEX_ACCESS_TOKEN OPENAI_FEDERATION_RULE_ID OPENAI_IDENTITY_TOKEN_FILE \
          OPENAI_WORKLOAD_IDENTITY_CONTEXT CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY \
          ANTHROPIC_AUTH_TOKEN GEMINI_API_KEY GOOGLE_API_KEY GOOGLE_GENAI_API_KEY
    export CODEX_HOME="$CODEX_DIR"
    # 0.166 refuses to start when CODEX_HOME names a directory that does not exist
    # ("Error finding codex home"), and a freshly built worker has none until the
    # first Codex run (first live job, #171), so it is created here, private.
    if ! ( umask 077; mkdir -p "$CODEX_DIR" ) 2>/dev/null || [ ! -w "$CODEX_DIR" ]; then
      echo "rt-codex: cannot create or write Codex's home $CODEX_DIR; not running" >&2
      exit "$EX_CONFIG"
    fi
    # Codex keeps one session file per run under ~/.codex/sessions and never prunes
    # them. run-job copies each to the NAS at the end of its run, so files older than
    # 7 days are swept here, as rt-gemini sweeps its per-run homes (#203 review).
    find "$CODEX_DIR/sessions" -type f -name '*.jsonl' -mtime +7 -delete 2>/dev/null || true
    find "$CODEX_DIR/sessions" -mindepth 1 -type d -empty -delete 2>/dev/null || true

    unenforced=()
    [ -n "$max_turns" ]  && unenforced+=( "max_turns=$max_turns" )
    [ -n "$max_budget" ] && unenforced+=( "max_budget_usd=$max_budget" )
    [ -n "$allowed" ]    && unenforced+=( "allowed_tools" )
    [ ${#unenforced[@]} -gt 0 ] \
      && echo "rt-codex: Codex has no turn cap, budget cap or tool allowlist; not enforced: ${unenforced[*]} (the wall clock still applies)" >&2

    args=( exec --json )
    [ -n "$cwd" ] && args+=( -C "$cwd" )
    args+=( --dangerously-bypass-approvals-and-sandbox --ignore-user-config
            -c 'forced_login_method="api"' -c 'project_doc_fallback_filenames=["CLAUDE.md"]' )
    case "${GH_TOKEN_ACCESS:-}" in
      ''|*[!a-z-]*) ;;
      *) args+=( -c "shell_environment_policy.set.GH_TOKEN_ACCESS=\"$GH_TOKEN_ACCESS\"" ) ;;
    esac
    if [ -n "$key" ] && ( umask 077; mkdir -p "$STATE" ) 2>/dev/null; then
      find "$STATE" -maxdepth 1 -type f -mtime +2 -delete 2>/dev/null
      rm -f "$STATE/$key.last-message" "$STATE/$key.thread" 2>/dev/null
      args+=( -o "$STATE/$key.last-message" )
    fi
    [ -n "$model" ] && args+=( -m "$model" )
    git -C "${cwd:-.}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || args+=( --skip-git-repo-check )
    exec "$CODEX_BIN" "${args[@]}"
    ;;

  normalize)
    [ -n "$raw" ] && [ -n "$result" ] && [ -n "$txt" ] || usage
    rm -f "$result" 2>/dev/null
    nev="$(jq -n -R '[inputs | fromjson? | objects] | length' "$raw" 2>/dev/null)"
    case "$nev" in ''|0|*[!0-9]*)
      cp "$raw" "$txt" 2>/dev/null || true
      exit 0 ;;
    esac
    lastf=/dev/null; haslast=0
    if [ -n "$key" ] && [ -f "$STATE/$key.last-message" ]; then
      lastf="$STATE/$key.last-message"; haslast=1
    fi
    # The model the tokens belong to (tokens_by_model): the one the session
    # transcript's turn_context lines name, else unknown. Silent, and never fatal.
    tmodel=unknown
    _tid="$(jq -n -R -r '[inputs | fromjson? | objects | select(.type == "thread.started")
                         | .thread_id | strings] | first // empty' "$raw" 2>/dev/null)"
    _tpath="$(session_file "$_tid")"
    if [ -n "$_tpath" ]; then
      _models="$(jq -R -r 'fromjson? | objects | select(.type == "turn_context")
                           | .payload.model? | strings | select(length > 0)' "$_tpath" 2>/dev/null | sort -u)"
      [ -n "$_models" ] && [ "$(printf '%s\n' "$_models" | wc -l)" -eq 1 ] && tmodel="$_models"
    fi
    unset _tid _tpath _models
    # One program for the text and the result, so the two never disagree.
    # shellcheck disable=SC2016  # jq variables, not shell ones
    prog='
      def events: [inputs | fromjson? | objects];
      def agent_text($ev): [$ev[] | select(.type == "item.completed") | .item | objects
                             | select(.type == "agent_message") | .text | strings] | last // "";
      def final($ev): if $haslast == "1" and ($last | length) > 0
                      then ($last | if endswith("\n") then .[:-1] else . end)
                      else agent_text($ev) end;
      def total($us; $k): [$us[] | (.[$k] // 0)]
                          | if all(type == "number") then add else error("usage") end;
      def none5: {in: null, cached: null, cache_write: null, out: null, thinking: null};
      def tokens($ev):
        [$ev[] | select(.type == "turn.completed") | .usage | objects] as $us
        | if ($us | length) == 0 then null
          else {in: (total($us; "input_tokens") - total($us; "cached_input_tokens")
                     - total($us; "cache_write_input_tokens")),
                cached: total($us; "cached_input_tokens"),
                cache_write: total($us; "cache_write_input_tokens"),
                out: (total($us; "output_tokens") - total($us; "reasoning_output_tokens")),
                thinking: total($us; "reasoning_output_tokens")}
            | if [.[] | select(. < 0)] == [] then . else error("inconsistent usage") end end;
      def result($ev):
        final($ev) as $ft
        | (try tokens($ev) catch null) as $tok
        | ([$ev[] | select(.type == "turn.completed")] | length) as $done
        | ($ev | any(.type == "turn.failed")) as $failed
        | {runtime: "codex",
           model: (if $model == "" then null else $model end),
           session_id: ([$ev[] | select(.type == "thread.started") | .thread_id | strings] | first
                        // (if $sid == "" then null else $sid end)),
           status: (if $done > 0 and ($failed | not) and $ft != "" then "ok" else "error" end),
           is_error: ($failed or ($done == 0 and ($ev | any(.type == "error")))),
           turns: ([$ev[] | select(.type == "item.completed") | .item | objects | .type | strings
                    | select(. != "agent_message" and . != "reasoning" and . != "todo_list" and . != "error")]
                   | length),
           tokens: ($tok // none5),
           tokens_by_model: (if $tok == null then null else {($tmodel): $tok} end),
           cost_usd: null,
           final_text: $ft};
      events as $ev | if $what == "text" then final($ev) else result($ev) end'
    jqn() { jq -n -R --arg model "$model" --arg sid "$sid" --arg haslast "$haslast" --arg tmodel "$tmodel" \
              --rawfile last "$lastf" --arg what "$1" "${@:2}" "$prog" "$raw"; }
    { jqn text -r > "$txt"; } 2>/dev/null || true
    if { jqn result -c > "$result.tmp"; } 2>/dev/null && [ -s "$result.tmp" ]; then
      mv -f "$result.tmp" "$result" 2>/dev/null || { rm -f "$result.tmp" 2>/dev/null; exit 1; }
    else
      # Events were read, but no result could be written: run-job fails the job rather
      # than file a run it cannot read as a success.
      rm -f "$result.tmp" 2>/dev/null; exit 1
    fi
    # Hand the thread id to `transcript`; the last message is consumed.
    if [ -n "$key" ]; then
      tid="$(jq -r '.session_id // empty' "$result" 2>/dev/null)"
      [ -n "$tid" ] && [ "$tid" != "$sid" ] && ( umask 077; mkdir -p "$STATE" && printf '%s\n' "$tid" > "$STATE/$key.thread" ) 2>/dev/null
      rm -f "$STATE/$key.last-message" 2>/dev/null
    fi
    exit 0
    ;;

  accepts-model)
    case "$model" in
      ''|*[!a-z0-9.-]*) exit 1 ;;
      gpt-*|codex-*|o[1-9]|o[1-9]-*) exit 0 ;;
      *) exit 1 ;;
    esac
    ;;

  about)
    printf '%s\n' '{"name":"Codex CLI","link":"https://github.com/openai/codex","trailer":"Co-Authored-By: Codex <noreply@openai.com>","trailer_note":""}'
    exit 0
    ;;

  live-session)
    [ -n "$raw" ] || usage
    # Only the start of the stream is read: thread.started comes first.
    tid="$(head -c 65536 "$raw" 2>/dev/null | jq -n -R -r '[inputs | fromjson? | objects
             | select(.type == "thread.started") | .thread_id | strings] | first // empty' 2>/dev/null)"
    tpath="$(session_file "$tid")"
    [ -n "$tpath" ] && printf '%s\t%s\n' "$tid" "$tpath"
    exit 0
    ;;

  enforces)
    # Neither cap exists in Codex (Limits, above).
    case "$limit" in
      turns|budget) exit 1 ;;
      *) usage ;;
    esac
    ;;

  update)
    # `codex --version` prints "codex-cli <version>"; a throwaway home keeps it from
    # writing state, and stdin is /dev/null.
    codex_version() {
      local h v; h="$(mktemp -d)" || return 1
      v="$(HOME="$h" CODEX_HOME="$h" "$CODEX_BIN" --version </dev/null 2>/dev/null | head -1)"
      rm -rf "$h"; printf '%s' "$v"
    }
    [ -x "$CODEX_BIN" ] || { echo "not installed ($CODEX_BIN)"; exit 3; }
    before="$(codex_version)"; [ -n "$before" ] || before=unknown
    have="${before##* }"
    want="${CLAUDE_RUNNER_CODEX_VERSION:-}"; want="${want#rust-v}"
    [ -n "$want" ] || { echo "not pinned, left at $before (CLAUDE_RUNNER_CODEX_VERSION is unset)"; exit 0; }
    [[ $want =~ ^[0-9A-Za-z][0-9A-Za-z.+-]*$ ]] \
      || { echo "update FAILED (was: $before): CLAUDE_RUNNER_CODEX_VERSION '$want' is not a version"; exit 1; }
    [ "$want" = "$have" ] && { echo "already current ($before)"; exit 0; }
    url=""; sha=""
    if [ "$want" != latest ] && [ -x "$CODEX_ROOT/$want/bin/codex" ]; then
      ver="$want"   # already on disk (a rollback): no release lookup, no download
    else
      if [ "$want" = latest ]; then api="$CODEX_RELEASES_API/latest"; else api="$CODEX_RELEASES_API/tags/rust-v$want"; fi
      rel="$(/usr/bin/curl -fsSL -H 'Accept: application/vnd.github+json' "$api" </dev/null 2>/dev/null)" \
        || { echo "update FAILED (was: $before): no release at $api"; exit 1; }
      ver="$(jq -r '.tag_name // empty | sub("^rust-v"; "")' <<<"$rel" 2>/dev/null)"
      url="$(jq -r --arg n "$CODEX_ASSET" '[.assets[]? | select(.name == $n) | .browser_download_url] | first // empty' <<<"$rel" 2>/dev/null)"
      sha="$(jq -r --arg n "$CODEX_ASSET" '[.assets[]? | select(.name == $n) | .digest // empty] | first // empty | sub("^sha256:"; "")' <<<"$rel" 2>/dev/null)"
      [[ $ver =~ ^[0-9A-Za-z][0-9A-Za-z.+-]*$ ]] && [ -n "$url" ] && [[ $sha =~ ^[0-9a-f]{64}$ ]] \
        || { echo "update FAILED (was: $before): release ${want} has no $CODEX_ASSET with a sha256 digest"; exit 1; }
      [ "$ver" = "$have" ] && { echo "already current ($before)"; exit 0; }
    fi
    if [ ! -w "$CODEX_ROOT" ] || [ ! -w "$(dirname "$CODEX_LINK")" ]; then
      echo "needs root: $have -> $ver is due, and $CODEX_ROOT is not writable by $(id -un)"
      exit 4
    fi
    if [ ! -x "$CODEX_ROOT/$ver/bin/codex" ]; then
      tmp="$(mktemp -d)" || { echo "update FAILED (was: $before): no temp dir"; exit 1; }
      why=""
      if ! /usr/bin/curl -fsSL -o "$tmp/$CODEX_ASSET" "$url" </dev/null 2>/dev/null; then why="download failed: $url"
      elif ! printf '%s  %s\n' "$sha" "$tmp/$CODEX_ASSET" | sha256sum -c --quiet >/dev/null 2>&1; then why="$CODEX_ASSET does not match its published sha256"
      else
        rm -rf "$CODEX_ROOT/$ver.partial"
        if ! { install -d -m 755 "$CODEX_ROOT/$ver.partial" \
               && tar --no-same-owner -xzf "$tmp/$CODEX_ASSET" -C "$CODEX_ROOT/$ver.partial"; } 2>/dev/null; then
          why="could not unpack $CODEX_ASSET"
        else
          for f in bin/codex bin/codex-exec-server codex-resources/bwrap; do
            [ -x "$CODEX_ROOT/$ver.partial/$f" ] || { why="the $ver package has no $f"; break; }
          done
          [ -n "$why" ] || mv "$CODEX_ROOT/$ver.partial" "$CODEX_ROOT/$ver" 2>/dev/null || why="could not move $ver into place"
        fi
        [ -z "$why" ] || rm -rf "$CODEX_ROOT/$ver.partial"
      fi
      rm -rf "$tmp"
      [ -z "$why" ] || { echo "update FAILED (was: $before): $why"; exit 1; }
    fi
    if ! { ln -sfn "$ver" "$CODEX_ROOT/current" && ln -sfn "$CODEX_ROOT/current/bin/codex" "$CODEX_LINK"; } 2>/dev/null; then
      echo "update FAILED (was: $before): could not point $CODEX_ROOT/current at $ver"
      exit 1
    fi
    after="$(codex_version)"
    [ "${after##* }" = "$ver" ] || { echo "update FAILED (was: $before): installed ${after:-nothing}, wanted $ver"; exit 1; }
    echo "updated: $before -> $after"
    exit 0
    ;;

  transcript)
    [ -n "$sid" ] && [ -n "$out" ] || usage
    tid=""
    [ -n "$key" ] && [ -f "$STATE/$key.thread" ] && tid="$(head -n 1 "$STATE/$key.thread" 2>/dev/null)"
    [ -n "$tid" ] || tid="$sid"
    tpath="$(session_file "$tid")"
    [ -n "$tpath" ] && cp -f "$tpath" "$out" 2>/dev/null
    [ -n "$key" ] && rm -f "$STATE/$key.thread" 2>/dev/null
    exit 0
    ;;

  *) usage ;;
esac
