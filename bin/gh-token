#!/usr/bin/env bash
# gh-token [--access <profile>] [owner/repo] — print a short-lived (~1h) GitHub App
# installation token, limited to ONE repository and to the permissions its caller
# needs (#176). The repo is the argument, else $GH_REPO (run-job exports it for
# project jobs); it also picks the installation that covers it, so one App serves
# repos under more than one owner.
#
# Profiles (--access). Default: `job` when a repo is named, `read` when none is.
#   job            contents, issues, pull_requests: write; metadata: read
#                  (the agent's gh login, and git push through gh-credential-helper)
#   job-workflows  job + workflows: write (only for a job whose spec sets "workflows": true)
#   comment        issues: write; metadata: read  (run-job's claim and failure comments)
#   read           contents, issues, pull_requests: read; metadata: read
#   merge          contents, pull_requests: write; metadata: read  (cr-automerge's arm/disarm)
#   pr             pull_requests: write; metadata: read  (run-job's PR footer, #174)
# Every profile but `read` needs a repo: no write token is ever minted for a whole
# installation. `read` with no repo covers the installation (ad-hoc jobs open no PR).
#
# What the App can grant (GET /app and /app/installations, checked 2026-11-02). A
# profile may name only these, at most at this level, or the mint is refused:
#   App lentago-claude-runner  contents write, issues write, metadata read,
#                              pull_requests write, workflows write
#   installations              lentago (all repositories), cpitzi (selected ones)
#
# What this buys: a token that leaks (into a transcript, a log, a PR body) is worth
# one repository and the least it needed, not every repo the App can reach. It is
# not a boundary against the agent itself, which can run gh-token too (#117).
#
# The key is root's (#177). gh-token is also the token broker: run as the agent user,
# which cannot read the key, it runs itself again as root through the one sudoers
# rule that user has (`claude ALL=(root) NOPASSWD: /opt/claude-runner/bin/gh-token`,
# held by cr-harden), naming the profile and repo explicitly because sudo drops
# GH_REPO with the rest of the environment. The agent can still ask for any profile
# on any repo while it runs; what it can no longer do is take the key away.
# As root nothing from the caller is trusted: the path seams below are ignored, PATH
# and HOME are fixed, curl skips any .curlrc, and the config file is parsed for its
# two numbers, never sourced.
#
# Config: /etc/claude-runner/gh-app.env  (APP_ID=, INSTALLATION_ID= the default install)
#         /etc/claude-runner/gh-app.pem  (App private key)        both root:root 0600
# GH_APP_ENV and GH_APP_PEM override the two paths, and GH_TOKEN_SUDO the sudo
# binary, for the test harness when not run as root.
set -euo pipefail
SELF=/opt/claude-runner/bin/gh-token   # the path the sudoers rule names
if [ "$EUID" -eq 0 ]; then
  PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root; export PATH HOME
  ENVF=/etc/claude-runner/gh-app.env
  PEM=/etc/claude-runner/gh-app.pem
else
  ENVF="${GH_APP_ENV:-/etc/claude-runner/gh-app.env}"
  PEM="${GH_APP_PEM:-/etc/claude-runner/gh-app.pem}"
fi

usage() { echo "usage: gh-token [--access job|job-workflows|comment|read|merge|pr] [owner/repo]" >&2; exit 2; }

access=""
while [ $# -gt 0 ]; do
  case "$1" in
    --access) [ $# -ge 2 ] || usage; access="$2"; shift 2 ;;
    -h|--help) usage ;;
    -*) usage ;;
    *) break ;;
  esac
done
[ $# -le 1 ] || usage
repo="${1:-${GH_REPO:-}}"
if [ -n "$repo" ] && ! [[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
  echo "gh-token: not an owner/repo: $repo" >&2; exit 2
fi
if [ -z "$access" ]; then
  if [ -n "$repo" ]; then access="job"; else access="read"; fi
fi

case "$access" in
  job)           perms='{"contents":"write","issues":"write","metadata":"read","pull_requests":"write"}' ;;
  job-workflows) perms='{"contents":"write","issues":"write","metadata":"read","pull_requests":"write","workflows":"write"}' ;;
  comment)       perms='{"issues":"write","metadata":"read"}' ;;
  read)          perms='{"contents":"read","issues":"read","metadata":"read","pull_requests":"read"}' ;;
  merge)         perms='{"contents":"write","metadata":"read","pull_requests":"write"}' ;;
  pr)            perms='{"metadata":"read","pull_requests":"write"}' ;;
  *) echo "gh-token: unknown access profile: $access" >&2; usage ;;
esac
if [ "$access" != read ] && [ -z "$repo" ]; then
  echo "gh-token: --access $access needs owner/repo (no installation-wide write token)" >&2; exit 2
fi

# The agent user: the key is there but not ours to read, so mint as root.
if [ "$EUID" -ne 0 ] && [ -e "$PEM" ] && [ ! -r "$PEM" ]; then
  exec "${GH_TOKEN_SUDO:-sudo}" -n "$SELF" --access "$access" ${repo:+"$repo"}
fi

# Read, never sourced: as root, this file must not be able to run code.
conf() { sed -n "s/^[[:space:]]*$1=[\"']\{0,1\}\([0-9][0-9]*\)[\"']\{0,1\}[[:space:]]*\$/\1/p" "$ENVF" 2>/dev/null | tail -1; }
APP_ID="$(conf APP_ID)"; INSTALLATION_ID="$(conf INSTALLATION_ID)"
[ -n "$APP_ID" ] || { echo "gh-token: APP_ID not set in $ENVF" >&2; exit 1; }
[ -s "$PEM" ] || { echo "gh-token: missing/empty $PEM" >&2; exit 1; }

b64url(){ openssl base64 -A | tr '+/' '-_' | tr -d '='; }
now=$(date +%s)
hdr=$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url)
pld=$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((now-60))" "$((now+540))" "$APP_ID" | b64url)
sig=$(printf '%s' "$hdr.$pld" | openssl dgst -sha256 -sign "$PEM" -binary | b64url)
jwt="$hdr.$pld.$sig"
ghapi(){ curl -q -fsSL -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
                    -H "X-GitHub-Api-Version: 2022-11-28" "$@"; }

# The installation that covers the repo; INSTALLATION_ID when none is named or the
# lookup fails (a repo it does not cover then fails the mint, as it should).
inst=""
if [ -n "$repo" ]; then
  inst=$(ghapi "https://api.github.com/repos/$repo/installation" 2>/dev/null | jq -r .id) || inst=""
fi
{ [ -n "$inst" ] && [ "$inst" != null ]; } || inst="${INSTALLATION_ID:-}"
[ -n "$inst" ] || { echo "gh-token: set INSTALLATION_ID in $ENVF, or pass owner/repo" >&2; exit 1; }

body="$(jq -cn --argjson p "$perms" --arg r "${repo#*/}" --arg named "$repo" \
  'if $named == "" then {permissions: $p} else {repositories: [$r], permissions: $p} end')"
tok="$(ghapi -X POST -d "$body" "https://api.github.com/app/installations/$inst/access_tokens" | jq -r '.token // empty')" || tok=""
[ -n "$tok" ] || { echo "gh-token: the mint returned no token ($access${repo:+ for $repo})" >&2; exit 1; }
printf '%s\n' "$tok"
