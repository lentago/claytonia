#!/usr/bin/env bash
# gh-token [owner/repo] — print a short-lived (~1h) GitHub App installation token
# for the installation that covers owner/repo (default: $GH_REPO, else INSTALLATION_ID).
# Config: /etc/claude-runner/gh-app.env  (APP_ID=, INSTALLATION_ID= the default install)
#         /etc/claude-runner/gh-app.pem  (App private key)
set -euo pipefail
ENVF=/etc/claude-runner/gh-app.env
PEM=/etc/claude-runner/gh-app.pem
# shellcheck source=/dev/null
[ -f "$ENVF" ] && . "$ENVF"
: "${APP_ID:?APP_ID not set in $ENVF}"
[ -s "$PEM" ] || { echo "gh-token: missing/empty $PEM" >&2; exit 1; }

b64url(){ openssl base64 -A | tr '+/' '-_' | tr -d '='; }
now=$(date +%s)
hdr=$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url)
pld=$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((now-60))" "$((now+540))" "$APP_ID" | b64url)
sig=$(printf '%s' "$hdr.$pld" | openssl dgst -sha256 -sign "$PEM" -binary | b64url)
jwt="$hdr.$pld.$sig"
ghapi(){ curl -fsSL -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
                    -H "X-GitHub-Api-Version: 2022-11-28" "$@"; }

# A named repo (argument, else GH_REPO, which run-job exports for project jobs)
# resolves to the installation that covers it, so one App can serve repos under
# more than one owner. INSTALLATION_ID is the fallback when no repo is named or
# the lookup fails, which keeps every pre-existing caller on the org install.
repo="${1:-${GH_REPO:-}}"
inst=""
if [ -n "$repo" ]; then
  inst=$(ghapi "https://api.github.com/repos/$repo/installation" 2>/dev/null | jq -r .id) || inst=""
fi
{ [ -n "$inst" ] && [ "$inst" != null ]; } || inst="${INSTALLATION_ID:-}"
[ -n "$inst" ] || { echo "gh-token: set INSTALLATION_ID in $ENVF, or pass owner/repo" >&2; exit 1; }

ghapi -X POST "https://api.github.com/app/installations/$inst/access_tokens" | jq -r .token
