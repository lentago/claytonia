#!/usr/bin/env bash
# git credential helper backed by the GitHub App. Re-mints on each 'get'.
# The token covers only the job's repository ($GH_REPO, which run-job exports) with
# the job's access profile ($GH_TOKEN_ACCESS: job, or job-workflows when the spec
# opts in; #176). With neither set, gh-token falls back to a read-only token.
[ "${1:-}" = get ] || exit 0
args=()
[ -n "${GH_TOKEN_ACCESS:-}" ] && args+=( --access "$GH_TOKEN_ACCESS" )
tok="$("${GH_TOKEN_BIN:-/usr/local/bin/gh-token}" "${args[@]}" 2>/dev/null)" || exit 0   # GH_TOKEN_BIN: test seam
echo "username=x-access-token"
echo "password=$tok"
