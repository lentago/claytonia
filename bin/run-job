#!/usr/bin/env bash
# run-job <jobfile> — execute ONE Claude job headless and file its output.
# Job = plain text (whole file is the prompt) OR a .json spec:
#   {"prompt":"...", "project":"name", "model":"...", "cwd":"...",
#    "max_turns":N, "issue":N, "max_budget_usd":N, "timeout_sec":N, "allowed_tools":"..."}
# If "project" is set it is resolved via projects/registry.json: a CLEAN checkout
# of the repo is prepared (repo CLAUDE.md applies), per-project memory is loaded,
# and the agent is told to branch + open a PR (never merge).
# Every run is bounded (issue #114): turns, spend and wall-clock each resolve
# spec > project registry > runner.env default, like model. A limit hit routes
# to failed/ and is named as limit=turns|budget|timeout in the .meta.
set -uo pipefail

JOBS_ROOT="${JOBS_ROOT:-/srv/jobs}"
RUNNER_ROOT=/opt/claude-runner
REGISTRY="$JOBS_ROOT/projects/registry.json"
WORKROOT="${CLAUDE_RUNNER_WORKROOT:-/home/claude/work}"
CLAUDE_BIN="${CLAUDE_BIN:-/home/claude/.local/bin/claude}"

[ -f "$RUNNER_ROOT/etc/runner.env" ] && . "$RUNNER_ROOT/etc/runner.env"
[ -f /etc/claude-runner/token.env ] && . /etc/claude-runner/token.env
export CLAUDE_CODE_OAUTH_TOKEN="${CLAUDE_CODE_OAUTH_TOKEN:-}"
export HOME="${HOME:-/home/claude}"
export PATH="${CLAUDE_RUNNER_PATH:-/home/claude/.local/bin:/usr/local/bin:/usr/bin:/bin}"  # override lets the test harness inject stub bins

DEF_MODEL="${CLAUDE_RUNNER_MODEL:-}"
DEF_CWD="${CLAUDE_RUNNER_CWD:-/home/claude/work}"
DEF_MAXTURNS="${CLAUDE_RUNNER_MAX_TURNS:-}"
DEF_BUDGET="${CLAUDE_RUNNER_MAX_BUDGET_USD:-}"
DEF_TIMEOUT="${CLAUDE_RUNNER_TIMEOUT_SEC:-}"
KILL_AFTER=30        # grace after TERM before KILL: a worker is held at most timeout+30s
RC_TIMEOUT=7         # distinct exit for a wall-clock limit hit (run-job's own codes are 0-6)

jobfile="${1:-}"
[ -n "$jobfile" ] && [ -f "$jobfile" ] || { echo "run-job: no such jobfile: $jobfile" >&2; exit 2; }

base="$(basename "$jobfile")"
ts="$(date -u +%Y%m%dT%H%M%SZ)"
label="$(printf '%s' "${base%.*}" | tr -c 'A-Za-z0-9._-' '_')"
runid="${ts}-${label}"
sid="$(uuidgen)"

mkdir -p "$JOBS_ROOT"/{processing,done,failed,logs} 2>/dev/null || true
proc="$JOBS_ROOT/processing/$runid"
# Claim by atomic rename BEFORE reading or validating the job. This is the
# single-winner point: cross-worker races resolve here, and a loser finds the
# file already gone and exits cleanly with NO side effects (no stray log, owner,
# or failed/ record). Write the owner immediately after so a crash during the
# validation below still leaves a reapable state. Everything past this reads
# from $proc — never the inbox path, which another worker may already have.
mv "$jobfile" "$proc" 2>/dev/null || exit 0
printf 'owner=%s
started=%s
origname=%s
' "$(hostname)" "$(date -u +%s)" "$base" > "$proc.owner" 2>/dev/null || true

prompt=""; cwd="$DEF_CWD"; model=""; max_turns=""; max_budget=""; timeout_sec=""; allowed=""; project=""; spec_issue=""; spec_issue_set=0
case "$base" in
  *.json)
    if ! jq -e . "$proc" >/dev/null 2>&1; then
      echo "run-job: invalid JSON ($base)" >&2
      mv -f "$proc" "$JOBS_ROOT/failed/${runid}.badjson" 2>/dev/null || true
      rm -f "$proc.owner" 2>/dev/null || true
      exit 3
    fi
    prompt="$(jq -r '.prompt // empty' "$proc")"
    project="$(jq -r '.project // empty' "$proc")"
    c="$(jq -r '.cwd // empty' "$proc")";        [ -n "$c" ]  && cwd="$c"
    m="$(jq -r '.model // empty' "$proc")";       [ -n "$m" ]  && model="$m"
    max_turns="$(jq -r '.max_turns // empty' "$proc")"
    max_budget="$(jq -r '.max_budget_usd // empty' "$proc")"
    timeout_sec="$(jq -r '.timeout_sec // empty' "$proc")"
    allowed="$(jq -r '.allowed_tools // empty' "$proc")"
    spec_issue="$(jq -r '.issue // empty' "$proc")"; [ -n "$spec_issue" ] && spec_issue_set=1
    ;;
  *) prompt="$(cat "$proc")" ;;
esac

if [ -z "${prompt// /}" ]; then
  echo "run-job: empty prompt ($base)" >&2
  mv -f "$proc" "$JOBS_ROOT/failed/${runid}.emptyprompt" 2>/dev/null || true
  rm -f "$proc.owner" 2>/dev/null || true
  exit 3
fi

errlog="$JOBS_ROOT/logs/${runid}.stderr"; : > "$errlog"
repo=""; branch=""; user_prompt="$prompt"

if [ -n "$project" ]; then
  if [ ! -f "$REGISTRY" ] || ! jq -e --arg p "$project" 'has($p)' "$REGISTRY" >/dev/null 2>&1; then
    echo "run-job: unknown project '$project' (not in $REGISTRY)" >>"$errlog"
    mv -f "$proc" "$JOBS_ROOT/failed/$runid" 2>/dev/null || true
    echo "run-job FAIL runid=$runid unknown-project=$project" | systemd-cat -t claude-runner -p err
    exit 4
  fi
  pj="$(jq -c --arg p "$project" '.[$p]' "$REGISTRY")"
  repo="$(printf '%s' "$pj" | jq -r '.repo // empty')"
  branch="$(printf '%s' "$pj" | jq -r '.default_branch // "main"')"
  [ -z "$model" ] && model="$(printf '%s' "$pj" | jq -r '.model // empty')"
  [ -z "$max_turns" ]   && max_turns="$(printf '%s' "$pj" | jq -r '.max_turns // empty')"
  [ -z "$max_budget" ]  && max_budget="$(printf '%s' "$pj" | jq -r '.max_budget_usd // empty')"
  [ -z "$timeout_sec" ] && timeout_sec="$(printf '%s' "$pj" | jq -r '.timeout_sec // empty')"
  context_dir="$(printf '%s' "$pj" | jq -r '.context_dir // empty')"
  [ -z "$context_dir" ] && context_dir="$JOBS_ROOT/projects/$project"
  setup="$(printf '%s' "$pj" | jq -r '.setup // empty')"

  ckout="$WORKROOT/$project"
  {
    if [ -d "$ckout/.git" ]; then
      git -C "$ckout" fetch --quiet origin "$branch" \
        && git -C "$ckout" reset --hard "origin/$branch" \
        && git -C "$ckout" clean -fd \
        && git -C "$ckout" switch -C "$branch" "origin/$branch"
    else
      rm -rf "$ckout"; git clone --quiet "https://github.com/$repo.git" "$ckout"
    fi
  } >>"$errlog" 2>&1
  if [ ! -d "$ckout/.git" ]; then
    echo "run-job: checkout failed for $repo" >>"$errlog"
    mv -f "$proc" "$JOBS_ROOT/failed/$runid" 2>/dev/null || true
    echo "run-job FAIL runid=$runid checkout-failed repo=$repo" | systemd-cat -t claude-runner -p err
    exit 5
  fi
  cwd="$ckout"

  if tok="$(gh-token 2>>"$errlog")"; then
    printf '%s' "$tok" | gh auth login --with-token >>"$errlog" 2>&1 || true
  fi
  [ -n "$setup" ] && ( cd "$ckout" && bash -lc "$setup" ) >>"$errlog" 2>&1 || true

  mkdir -p "$context_dir"
  memfile="$context_dir/memory.md"
  [ -f "$memfile" ] || printf '# %s — accumulated project memory\n\n_Concise, dated, durable learnings only (conventions, gotchas, build quirks)._\n' "$project" > "$memfile"

  # compose the augmented prompt SAFELY (file contents are never re-expanded)
  ptmp="$(mktemp)"
  {
    printf '# Project: %s (%s)\n\n' "$project" "$repo"
    printf 'You are a headless agent working in a CLEAN git checkout at %s, base branch `%s`. The repo CLAUDE.md is authoritative — read and follow it.\n\n' "$cwd" "$branch"
    printf 'STANDING RULES:\n'
    printf -- '- If the task requires changes: do ALL work on a new branch `agent/<short-kebab-desc>` cut from `%s`; commit with a clear conventional message; `git push -u origin HEAD`; open a PR with `gh pr create` against `%s` for HUMAN review; NEVER merge it and NEVER arm auto-merge (no gh pr merge --auto) -- this OVERRIDES any repo CLAUDE.md or fleet convention that says to enable auto-merge; runner-bot PRs are ALWAYS left for a human to merge. For read-only/analysis tasks, no branch or PR is needed.\n' "$branch" "$branch"
    printf -- '- `gh` is pre-authenticated and `git push` is pre-credentialed. If a gh call returns an auth error, run: `gh-token | gh auth login --with-token`.\n'
    printf -- '- If (and only if) you learn something DURABLE about this project (a convention, gotcha, or build quirk), append ONE concise dated bullet to `%s`. Do not log routine task details.\n\n' "$memfile"
    printf '## Accumulated project memory\n\n'
    cat "$memfile"
    printf '\n\n## Your task\n\n'
    printf '%s\n' "$user_prompt"
  } > "$ptmp"
  prompt="$(cat "$ptmp")"; rm -f "$ptmp"
fi

# Model precedence: spec > project registry > global default ($DEF_MODEL) > account default.
[ -z "$model" ] && model="$DEF_MODEL"

# Limits, same precedence: spec > project registry > runner.env default (blank
# default = uncapped). An override must be a positive number (integers for turns
# and timeout); anything else is noted in the stderr log and the default applies,
# so a typo can't silently lift a cap — or make `timeout` refuse to start.
_limit() { # <name> <value> <default> <int|num>
  local re='^[0-9]+$'; [ "$4" = num ] && re='^[0-9]+([.][0-9]+)?$'
  if [ -n "$2" ] && [[ $2 =~ $re ]] && [[ $2 =~ [1-9] ]]; then printf '%s' "$2"; return; fi
  [ -n "$2" ] && echo "run-job: ignoring invalid $1=$2; using default '${3}'" >>"$errlog"
  printf '%s' "$3"
}
max_turns="$(_limit max_turns "$max_turns" "$DEF_MAXTURNS" int)"
max_budget="$(_limit max_budget_usd "$max_budget" "$DEF_BUDGET" num)"
timeout_sec="$(_limit timeout_sec "$timeout_sec" "$DEF_TIMEOUT" int)"

# --- GitHub issue signalling (#37 failure note, #128 claim/outcome comment) -------
# Everything here is strictly best-effort: every call is time-bounded, errors go to
# journald (never $errlog, whose last line is quoted as the failure reason), and no
# outcome of any call changes the job's result.
GH_API_TIMEOUT="${CLAUDE_RUNNER_GH_TIMEOUT:-15}"
GRAFANA_URL="${CLAUDE_RUNNER_GRAFANA_URL:-}"

# issue_of_prompt <text> <repo> — the job's own issue, from the prompt (#130).
# Only explicit forms count: `issue #N`, `Closes|Fixes #N`, and `<owner>/<repo>#N` or
# `<repo>#N` naming <repo> itself (full name or basename). Bare `#N` and references to
# other repos are ignored. Prints N only when exactly one distinct candidate remains;
# zero or several print nothing (no claim comment rather than a guess).
issue_of_prompt() {
  local _text="$1" _repo="${2,,}" _base _ref _name
  _base="${_repo##*/}"
  {
    printf '%s' "$_text" | grep -oiE '(^|[^[:alnum:]_])(issue[[:space:]]+|closes[[:space:]]+|fixes[[:space:]]+)#[0-9]+' \
      | grep -oE '[0-9]+$'
    printf '%s' "$_text" | grep -oE '(^|[^[:alnum:]._/-])([[:alnum:]._-]+/)?[[:alnum:]._-]+#[0-9]+' \
      | sed -E 's/^[^[:alnum:]._-]//' \
      | while IFS= read -r _ref; do
          _name="${_ref%#*}"; _name="${_name,,}"
          if [ "$_name" = "$_repo" ] || [ "$_name" = "$_base" ]; then printf '%s\n' "${_ref##*#}"; fi
        done
  } | sort -un | awk 'NF{n++; v=$0} END{if(n==1) print v}'
}

# gh_issue_api <repo> <gh api args...> — repo-scoped App token, bounded call; the
# response is on stdout, failures return non-zero after a one-line journald note.
gh_issue_api() {
  local _repo="$1" _tok _out; shift
  if ! _tok="$(timeout -k 2 "$GH_API_TIMEOUT" gh-token "$_repo" 2>/dev/null)" || [ -z "$_tok" ]; then
    echo "run-job: gh-token failed for $_repo ($runid); issue comment skipped" | systemd-cat -t claude-runner -p warning
    return 1
  fi
  if ! _out="$(GH_TOKEN="$_tok" timeout -k 2 "$GH_API_TIMEOUT" gh api "$@" 2>&1)"; then
    echo "run-job: gh api failed ($runid): $(printf '%s' "$_out" | head -c 200 | tr '\n' ' ')" | systemd-cat -t claude-runner -p warning
    return 1
  fi
  printf '%s' "$_out"
}

# Target issue, in the project repo only (ad-hoc jobs have no repo). The spec's
# `issue` is authoritative (a non-integer value means none, never a prompt guess);
# otherwise fall back to the strict prompt parse.
issue=""
if [ -n "${project:-}" ] && [ -n "${repo:-}" ]; then
  if [ "$spec_issue_set" = 1 ]; then
    case "$spec_issue" in ''|*[!0-9]*|0*) ;; *) issue="$spec_issue" ;; esac
  else
    issue="$(issue_of_prompt "$user_prompt" "$repo")"
  fi
fi

outjson="$JOBS_ROOT/logs/${runid}.json"
outtxt="$JOBS_ROOT/logs/${runid}.txt"
meta="$JOBS_ROOT/logs/${runid}.meta"

args=( -p --dangerously-skip-permissions --output-format json --session-id "$sid" )
[ -n "$model" ]      && args+=( --model "$model" )
[ -n "$max_turns" ]  && args+=( --max-turns "$max_turns" )
[ -n "$max_budget" ] && args+=( --max-budget-usd "$max_budget" )
[ -n "$allowed" ]    && args+=( --allowedTools "$allowed" )

# Write <sid>.runid sidecar next to the live transcript so the worker Alloy can
# attach a runid label to the transcript stream without waiting for the run to end.
# Directory name mirrors Claude Code's cwd-encoding convention (/ → -).
_sid_projdir="$HOME/.claude/projects/$(printf '%s' "$cwd" | tr '/' '-')"
mkdir -p "$_sid_projdir" 2>/dev/null || true
printf '%s\n' "$runid" > "$_sid_projdir/${sid}.runid" 2>/dev/null || true
unset _sid_projdir

# Claim comment (#128): tell the issue a worker has it, so nobody double-dispatches.
# Edited in place at completion; the id is recorded in the .meta for that update.
claim_id=""; claim_head=""
if [ -n "$issue" ]; then
  _live=""
  [ -n "$GRAFANA_URL" ] && _live=" Live: ${GRAFANA_URL%/}/d/claude-runner-fleet?var-runid=${runid}."
  claim_head="run \`${runid}\` on ${HOSTNAME:-$(hostname)} (${model:-default}), started $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
  claim_id="$(gh_issue_api "$repo" "repos/$repo/issues/$issue/comments" \
    -f body="🤖 claytonia is working this — ${claim_head}.${_live}" --jq .id)" || claim_id=""
  case "$claim_id" in ''|*[!0-9]*) claim_id="" ;; esac
  unset _live
fi

# notice, not info: claude-inbox.service sets LogLevelMax=notice (#118).
echo "run-job START runid=$runid project=${project:-none} model=${model:-default} cwd=$cwd" | systemd-cat -t claude-runner -p notice
cr-emit started "$runid" "${project:-}" "${model:-}" 2>/dev/null || true
start=$(date -u +%s)
# Heartbeat: mark this worker as underway in Loki (event=job_running) every 10s while
# the job is in flight, so the "Runners underway" dashboard panel has an in-flight
# signal (the job_complete event only lands at the end). One beat fires immediately so
# even sub-10s jobs register. Best-effort; killed as soon as the job returns.
( while :; do cr-emit running "$runid" "${project:-}" "${model:-}" 2>/dev/null; sleep 10; done ) &
hb_pid=$!
# Wall-clock bound: TERM at timeout_sec, KILL $KILL_AFTER s later. Without it a
# wedged CLI holds this worker forever — its heartbeat stays fresh, so the reaper
# never reclaims the job, and process-inbox is serial behind its flock.
tmo=()
[ -n "$timeout_sec" ] && tmo=( timeout --signal=TERM --kill-after="$KILL_AFTER" "$timeout_sec" )
( cd "$cwd" && printf '%s' "$prompt" | "${tmo[@]}" "$CLAUDE_BIN" "${args[@]}" ) >"$outjson" 2>>"$errlog"
rc=$?
kill "$hb_pid" 2>/dev/null; wait "$hb_pid" 2>/dev/null
dur=$(( $(date -u +%s) - start ))

cost=""; turns=""; subtype=""; limit=""
if jq -e . "$outjson" >/dev/null 2>&1; then
  jq -r '.result // .text // ""' "$outjson" > "$outtxt" 2>/dev/null || true
  [ "$(jq -r '.is_error // false' "$outjson" 2>/dev/null)" = "true" ] && rc=1
  cost="$(jq -r '.total_cost_usd // empty' "$outjson" 2>/dev/null)"
  turns="$(jq -r '.num_turns // empty' "$outjson" 2>/dev/null)"
  subtype="$(jq -r '.subtype // empty' "$outjson" 2>/dev/null)"
else
  cp "$outjson" "$outtxt" 2>/dev/null || true
fi

# Name a limit hit. timeout exits 124 (TERM worked) or 137 (needed the KILL);
# the elapsed check keeps an unrelated SIGKILL (e.g. OOM) from reading as one.
# The CLI reports its own caps as result subtypes, not always with is_error set,
# so any error_* subtype is forced to a failure. The last errlog line is what
# the failure issue comment quotes as the reason.
if [ -n "$timeout_sec" ] && { [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; } && [ "$dur" -ge "$timeout_sec" ]; then
  limit=timeout; rc=$RC_TIMEOUT
  echo "run-job: limit=timeout — killed after ${dur}s (timeout_sec=$timeout_sec, TERM then KILL after ${KILL_AFTER}s)" >>"$errlog"
else
  case "$subtype" in
    error_max_turns)      limit=turns
      echo "run-job: limit=turns — stopped at ${turns:-?} turns (max_turns=$max_turns)" >>"$errlog" ;;
    error_max_budget_usd) limit=budget
      echo "run-job: limit=budget — stopped at \$${cost:-?} (max_budget_usd=$max_budget)" >>"$errlog" ;;
  esac
  case "$subtype" in error_*) [ "$rc" -eq 0 ] && rc=1 ;; esac
fi

# Extract PR URL from output now — used for both the no-PR check and the
# auto-merge disarm below, so it must be set before the done/failed routing.
prurl=""
if [ -n "${project:-}" ] && [ -n "${repo:-}" ] && [ -f "$outtxt" ]; then
  prurl="$(grep -oE 'https://github.com/[^ )]+/pull/[0-9]+' "$outtxt" 2>/dev/null | head -1)"
fi

# For project jobs that exit cleanly: verify a PR was actually opened.
# Agents that make no changes (analysis/read-only) stay on the base branch; those
# legitimately open no PR and are NOT failed here.  If the agent switched to a
# non-base branch but no PR URL appears in the output, fall back to a live gh
# query.  If that also finds nothing, the job is a failure — routes to failed/
# and is logged to errlog with the reason (rc=6).
if [ "$rc" -eq 0 ] && [ -n "${project:-}" ] && [ -n "${repo:-}" ] && [ -z "$prurl" ]; then
  _ab="$(git -C "$ckout" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  if [ -n "$_ab" ] && [ "$_ab" != "HEAD" ] && [ "$_ab" != "$branch" ]; then
    prurl="$(GH_TOKEN="$(gh-token 2>/dev/null)" gh pr list \
      --repo "$repo" --head "$_ab" --state open \
      --json url --jq '.[0].url' 2>/dev/null || true)"
    if [ -z "$prurl" ]; then
      rc=6
      echo "run-job: project job completed on branch '$_ab' but no open PR found (possible push/permission failure)" >>"$errlog"
    fi
  fi
  unset _ab
fi

# Capture the full reasoning transcript (assistant messages, thinking blocks, tool
# calls/results) that Claude Code wrote locally -> durable NAS log, keyed by runid.
# Best-effort; toggle off with CLAUDE_RUNNER_CAPTURE_TRANSCRIPT=0.
if [ "${CLAUDE_RUNNER_CAPTURE_TRANSCRIPT:-1}" != 0 ] && [ -n "$sid" ]; then
  tpath="$(find "$HOME/.claude/projects" -name "${sid}.jsonl" -print -quit 2>/dev/null)"
  [ -n "$tpath" ] && cp -f "$tpath" "$JOBS_ROOT/logs/${runid}.transcript.jsonl" 2>/dev/null || true
fi

{
  echo "runid=$runid"; echo "exit=$rc"; echo "duration_sec=$dur"
  echo "project=${project:-}"; echo "repo=${repo:-}"
  echo "model=${model:-default}"; echo "cwd=$cwd"
  echo "cost_usd=${cost}"; echo "num_turns=${turns}"; echo "session_id=${sid:-}"
  echo "limit=${limit}"; echo "max_turns=${max_turns}"
  echo "max_budget_usd=${max_budget}"; echo "timeout_sec=${timeout_sec}"
  echo "claim_comment_id=${claim_id}"; echo "issue=${issue}"
  echo "finished=$(date -u +%FT%TZ)"
} > "$meta"

if [ "$rc" -eq 0 ]; then
  mv -f "$proc" "$JOBS_ROOT/done/$runid" 2>/dev/null || true
  echo "run-job DONE runid=$runid project=${project:-none} dur=${dur}s cost=${cost:-?}" | systemd-cat -t claude-runner -p notice
  if [ -n "$claim_id" ]; then
    if [ -n "${prurl:-}" ]; then _outcome="opened ${prurl}"; else _outcome="no PR opened"; fi
    gh_issue_api "$repo" -X PATCH "repos/$repo/issues/comments/$claim_id" \
      -f body="🤖 claytonia ${claim_head} — ✅ finished; ${_outcome}." >/dev/null || true
    unset _outcome
  fi
else
  mv -f "$proc" "$JOBS_ROOT/failed/$runid" 2>/dev/null || true
  echo "run-job FAIL runid=$runid project=${project:-none} rc=$rc${limit:+ limit=$limit} dur=${dur}s (logs/${runid}.stderr)" | systemd-cat -t claude-runner -p err
  # Option 1 (issue #37): comment on the originating GitHub issue so dispatchers see
  # failures where they already look. If a claim comment exists (#128) it is edited
  # in place rather than adding a second comment; otherwise a new one is posted.
  # Strictly best-effort — never changes the job outcome.
  if [ -n "$issue" ]; then
    _reason="$(tail -1 "$errlog" 2>/dev/null | head -c 500)"
    [ -z "${_reason:-}" ] && _reason="(no stderr note)"
    _logtail="$(tail -20 "$errlog" 2>/dev/null)"
    _limitline=""
    [ -n "$limit" ] && _limitline="**Limit hit:** $limit  "$'\n'
    _body="$(printf '## Job failed: %s\n\n**Exit code:** %s  \n%s**Failure reason:** %s\n\n<details>\n<summary>Last 20 lines of job log</summary>\n\n```\n%s\n```\n</details>' \
      "$runid" "$rc" "$_limitline" "$_reason" "$_logtail")"
    if [ -n "$claim_id" ]; then
      _body="🤖 claytonia ${claim_head} — ❌ failed${limit:+ (limit hit: $limit)}."$'\n\n'"$_body"
      gh_issue_api "$repo" -X PATCH "repos/$repo/issues/comments/$claim_id" -f body="$_body" >/dev/null \
        || gh_issue_api "$repo" "repos/$repo/issues/$issue/comments" -f body="$_body" >/dev/null || true
    else
      gh_issue_api "$repo" "repos/$repo/issues/$issue/comments" -f body="$_body" >/dev/null || true
    fi
    unset _reason _logtail _body _limitline
  fi
fi
# Enforce the no-auto-merge rule: a runner-bot PR is ALWAYS left for a human, so if
# the agent opened one (and possibly armed auto-merge despite the standing rule),
# disarm it. Overrides any repo convention; runs win-or-lose. Best-effort.
# prurl was extracted above before the done/failed routing.
if [ -n "${prurl:-}" ]; then
  GH_TOKEN="$(gh-token 2>/dev/null)" gh pr merge "$prurl" --disable-auto >/dev/null 2>&1 \
    && echo "run-job: disarmed auto-merge on $prurl (bot PRs are human-reviewed)" | systemd-cat -t claude-runner -p notice || true
fi

rm -f "$proc.owner" 2>/dev/null || true
cr-emit "$runid" 2>/dev/null || true
exit "$rc"
