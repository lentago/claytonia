#!/usr/bin/env bash
# google-auth <client.json> <out.env> — mint the read-only Google token that
# google-read uses (ADR-0010). Run it ONCE on a desktop with a browser, not on a
# worker: it opens Google's consent page, catches the redirect on a loopback
# port, and writes GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN
# to <out.env> with mode 0600. It never prints the token.
#
# <client.json> is the "Desktop app" OAuth client downloaded from Google Cloud
# (Google Auth Platform → Clients). Publish the app (Audience → In production)
# first: a Testing-mode app's refresh tokens expire after 7 days. Scopes are
# fixed and read-only: gmail.readonly, calendar.readonly, drive.metadata.readonly.
#
# Then install <out.env> on every worker as /etc/claude-runner/google.env,
# root:claude 0640 (README § Google read access), and run `google-read check`.
set -uo pipefail
[ $# -eq 2 ] || { echo "usage: google-auth <client.json> <out.env>" >&2; exit 2; }
exec python3 - "$@" <<'PY'
import base64, hashlib, http.server, json, os, secrets, sys, urllib.parse, urllib.request, webbrowser

client_path, out_path = sys.argv[1], sys.argv[2]
SCOPES = ["https://www.googleapis.com/auth/gmail.readonly",
          "https://www.googleapis.com/auth/calendar.readonly",
          "https://www.googleapis.com/auth/drive.metadata.readonly"]

with open(client_path, encoding="utf-8") as f:
    c = json.load(f)
c = c.get("installed") or c.get("web") or c
cid, secret = c["client_id"], c["client_secret"]

verifier = secrets.token_urlsafe(64)
challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
state = secrets.token_urlsafe(24)
got = {}

class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        if q.get("state", [""])[0] != state:
            self.send_response(400); self.end_headers(); self.wfile.write(b"state mismatch"); return
        got.update({k: v[0] for k, v in q.items()})
        self.send_response(200); self.send_header("Content-Type", "text/plain"); self.end_headers()
        self.wfile.write(b"Done. You can close this tab and go back to the terminal.")
    def log_message(self, *a):
        pass

srv = http.server.HTTPServer(("127.0.0.1", 0), Handler)
redirect = "http://127.0.0.1:%d/" % srv.server_address[1]
url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode({
    "client_id": cid, "redirect_uri": redirect, "response_type": "code", "scope": " ".join(SCOPES),
    "access_type": "offline", "prompt": "consent", "state": state,
    "code_challenge": challenge, "code_challenge_method": "S256"})
print("Opening Google's consent page. If no browser opens, visit:\n\n  %s\n" % url, file=sys.stderr)
try:
    webbrowser.open(url)
except Exception:
    pass
while "code" not in got and "error" not in got:
    srv.handle_request()
if "error" in got:
    sys.exit("google-auth: consent failed: %s" % got["error"])

body = urllib.parse.urlencode({"code": got["code"], "client_id": cid, "client_secret": secret,
                               "redirect_uri": redirect, "grant_type": "authorization_code",
                               "code_verifier": verifier}).encode()
with urllib.request.urlopen(urllib.request.Request("https://oauth2.googleapis.com/token", data=body), timeout=30) as r:
    tok = json.load(r)
if "refresh_token" not in tok:
    sys.exit("google-auth: Google returned no refresh token (revoke the app's access at "
             "myaccount.google.com/permissions and run this again)")
granted = sorted(tok.get("scope", "").split())
if any(not s.endswith(".readonly") for s in granted if s.startswith("https://www.googleapis.com/auth/")):
    sys.exit("google-auth: refusing to save a token with a non-read-only scope: %s" % " ".join(granted))

fd = os.open(out_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    f.write("# google-read credentials (read-only scopes); minted by google-auth\n")
    f.write("GOOGLE_CLIENT_ID=%s\nGOOGLE_CLIENT_SECRET=%s\nGOOGLE_REFRESH_TOKEN=%s\n" % (cid, secret, tok["refresh_token"]))
os.chmod(out_path, 0o600)
print("google-auth: wrote %s (0600). Granted scopes: %s" % (out_path, " ".join(granted)), file=sys.stderr)
PY
