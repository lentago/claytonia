#!/usr/bin/env bash
# cr-publish-share — publish the queue's README to the root of the NAS share from
# main (#185), so the copy dispatchers read is an artifact of a merged commit and
# never a hand edit.
#
# Source: docs/share/README.md in this worker's gitops checkout of claytonia, which
# the gitops loop resets to origin/main every 5 minutes: /opt/claytonia, or
# /opt/bullpen on a worker not yet rebuilt under #65. cron runs this every minute
# on every worker.
#
# The published copy is the source plus one last line stamping the commit it came
# from and that commit's time. A worker never overwrites a copy stamped newer than
# its own checkout, so a worker whose checkout is stale (a wedged gitops loop, or
# mid-rollout) cannot flip the share back to older text. A copy with no stamp, or
# one stamped more than an hour in the future, counts as a hand edit and is
# overwritten. Each run compares first, so a steady state writes nothing. A change
# goes to a per-worker temp file renamed into place, so a reader never sees half a
# file; temp files a killed run left behind are swept after ten minutes.
# Best-effort: problems are journald notes, each logged once until it changes,
# never a failure.
# Seams for the tests: JOBS_ROOT, CR_PUBLISH_SRC (the source file),
# CR_PUBLISH_STAMP ("<sha> <commit epoch>"), CR_PUBLISH_STATE (the note memory).
set -uo pipefail
JOBS_ROOT="${JOBS_ROOT:-/srv/jobs}"
STATE="${CR_PUBLISH_STATE:-${XDG_RUNTIME_DIR:-/tmp}/cr-publish-share.last}"

# note_once <message> — log a message to journald the first time it occurs; the
# state file remembers every one seen (one per line) until the next publish clears it.
note_once() {
  local m="${1//$'\n'/ }"
  grep -qxF -- "$m" "$STATE" 2>/dev/null && return 0
  printf '%s\n' "$m" >> "$STATE" 2>/dev/null || true
  echo "cr-publish-share: $m" | systemd-cat -t claude-runner -p notice 2>/dev/null || true
}
all_clear() { rm -f "$STATE" 2>/dev/null || true; }

src="${CR_PUBLISH_SRC:-}"
if [ -z "$src" ]; then
  for d in /opt/claytonia /opt/bullpen; do
    [ -f "$d/docs/share/README.md" ] && { src="$d/docs/share/README.md"; break; }
  done
fi
[ -n "$src" ] && [ -s "$src" ] || { note_once "no docs/share/README.md in the gitops checkout; nothing published"; exit 0; }
[ -d "$JOBS_ROOT/inbox" ] || { note_once "no queue at $JOBS_ROOT; nothing published"; exit 0; }

# The commit the source came from, and when it was committed. The checkout is
# root-owned (the gitops loop writes it) and this runs as claude, so git refuses it
# as "dubious ownership" unless told otherwise (#188). safe.directory is trusted
# from the command line and names only this checkout, for one read-only `git log`.
# The path is resolved physically (pwd -P), the form git compares safe.directory to.
# A source whose commit cannot be read is stamped "unknown", time 0, which is older
# than any real stamp: such a worker may replace an unstamped copy but never one
# published from a known commit. The failure is noted once, with git's reason.
top="$(cd "$(dirname "$src")/../.." 2>/dev/null && pwd -P)"
srcrel="${src#"$(cd "$(dirname "$src")" 2>/dev/null && cd ../.. && pwd)"/}"
if [ -n "${CR_PUBLISH_STAMP:-}" ]; then
  stamp="$CR_PUBLISH_STAMP"
elif ! stamp="$(git -c safe.directory="$top" -C "$top" log -1 --format='%H %ct' -- "$srcrel" 2>&1)" || [ -z "$stamp" ]; then
  note_once "cannot read the commit of $src, so it is stamped unknown and will not replace a stamped copy: $(printf '%s' "${stamp:-no commit touches it}" | head -c 200 | tr '\n' ' ')"
  stamp=""
fi
sha="${stamp%% *}"; ct="${stamp##* }"
case "$ct" in ''|*[!0-9]*) sha=unknown; ct=0 ;; esac

dst="$JOBS_ROOT/README.md"
gen="$(mktemp)"; tmp=""
trap 'rm -f "$gen" ${tmp:+"$tmp"} 2>/dev/null' EXIT
trap 'exit 1' INT TERM
{ cat "$src"
  printf '<!-- published by cr-publish-share from lentago/claytonia@%s (commit time %s); edit docs/share/README.md there -->\n' \
    "${sha:0:12}" "$ct"
} > "$gen"

find "$JOBS_ROOT" -maxdepth 1 -name '.README.md.*.tmp' -mmin +10 -delete 2>/dev/null
if cmp -s "$gen" "$dst" 2>/dev/null; then all_clear; exit 0; fi

share_ct="$(sed -n 's/.*(commit time \([0-9][0-9]*\)).*/\1/p' "$dst" 2>/dev/null | tail -1)"
if [ -n "$share_ct" ] && [ "$share_ct" -le $(( $(date +%s) + 3600 )) ] && [ "$ct" -lt "$share_ct" ]; then
  note_once "the share copy is from a newer commit (time $share_ct) than this checkout (${sha:0:12}, time $ct); not overwriting it"
  exit 0
fi

tmp="$JOBS_ROOT/.README.md.$(hostname).$$.tmp"
if err="$( { cp "$gen" "$tmp" && mv -f "$tmp" "$dst"; } 2>&1 )"; then
  tmp=""
  all_clear
  echo "cr-publish-share: published $dst from ${sha:0:12}" | systemd-cat -t claude-runner -p notice 2>/dev/null || true
else
  err="${err//"$tmp"/<temp file>}"   # the temp name carries a PID; keep the note stable
  note_once "could not publish $dst: $(printf '%s' "$err" | head -c 200 | tr '\n' ' ')"
fi
exit 0
