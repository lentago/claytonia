#!/usr/bin/env bash
# rt-gemini — the Gemini CLI runtime adapter (#166, #170).
#
# Implements the adapter contract in the rt-claude header: run, normalize,
# transcript and accepts-model, and the normalized result schema. It is inert
# until a job resolves runtime=gemini; run-job reaches it only as bin/rt-gemini.
# Written against Gemini CLI 0.66.0, the version on the workers, from the CLI's
# bundled source and the captures in test/fixtures/runtimes/.
#
# run
#   Execs  gemini -p "" -o json --approval-mode yolo --session-id <uuid> [-m <model>]
#   with the prompt on stdin: `-p ""` makes the stdin text the whole prompt.
#   Exec keeps the tree under run-job's timeout(1) to the CLI's own two node
#   processes (it relaunches itself once). timeout(1) signals that whole process
#   group, and the parent also forwards TERM to the child.
#   Credentials (judgment A): `run` sources $CLAUDE_RUNNER_GEMINI_ENV (default
#   /etc/claude-runner/gemini.env, root:claude 0640, installed by hand). The file
#   sets GOOGLE_GENAI_USE_VERTEXAI=true, GOOGLE_CLOUD_PROJECT, GOOGLE_CLOUD_LOCATION=global
#   and GOOGLE_APPLICATION_CREDENTIALS=/etc/claude-runner/gemini-sa.json, a
#   service account with Vertex AI User only. Nothing else reads the file, and no
#   value from it is ever printed. Before the exec, `run` unsets the Claude and
#   OpenAI credential variables, so the Gemini process holds no other vendor's
#   secret. A project's .env cannot override these: Gemini never replaces a
#   variable that is already set.
#   Settings: every run gets its own Gemini home, $XDG_STATE_HOME (default
#   ~/.local/state)/claytonia/gemini/<session-id>, passed as GEMINI_CLI_HOME, so
#   it is outside every checkout and an agent's `git add -A` cannot commit it.
#   Its .gemini/settings.json turns vendor usage statistics off
#   (privacy.usageStatisticsEnabled), loads the repo's CLAUDE.md as context
#   (context.fileName ["GEMINI.md","AGENTS.md","CLAUDE.md"]) and carries the turn
#   cap. A fresh home also keeps Gemini's global memory (its save_memory tool) and
#   session history from carrying one job's context into the next; durable
#   learnings belong in the project's memory.md. Homes older than 7 days are swept
#   at the next run (run-job has copied the transcript to the NAS by then).
#   Why not a system settings file: 0.66 loads one (GEMINI_CLI_SYSTEM_SETTINGS_PATH)
#   only when the file and every directory above it are owned by root and not
#   writable by group or others, which a file this adapter writes as `claude` can
#   never be. Precedence in 0.66, lowest first: these user settings, then the
#   checkout's .gemini/settings.json (loaded, because the run trusts the workspace),
#   then /etc/gemini-cli/settings.json, which bin/cr-harden installs root-owned on
#   every worker with usage statistics off, so a checkout cannot turn them back on
#   (#205). A turn cap is per job and cannot live in that shared file, so a job
#   with max_turns is refused, before the CLI starts, when its checkout's
#   .gemini/settings.json names maxSessionTurns (parsed, at any depth) or cannot
#   be parsed. Any other checkout settings file gets a one-line stderr note.
#   GEMINI_CLI_TRUST_WORKSPACE=true: headless 0.66 exits 55 in an untrusted cwd.
#   NO_COLOR=1 keeps ANSI codes out of the stderr line a failure comment quotes.
#   Git credentials: 0.66's shell tool starts every command with seven git config
#   overrides appended through GIT_CONFIG_COUNT, the first an empty
#   credential.helper. Command-line scope comes after ~/.gitconfig, so the empty
#   value clears the worker's credential.https://github.com.helper
#   (gh-credential-helper), and `git push` fails with "could not read Username"
#   (first live run, #170). The tool passes every GIT_CONFIG_* variable it is
#   started with through to the command, GIT_CONFIG_PARAMETERS (the `git -c`
#   channel) included, and git applies that after GIT_CONFIG_COUNT. So `run` copies
#   the helper from ~/.gitconfig into GIT_CONFIG_PARAMETERS under the same
#   https://github.com scope, and no other host is ever offered the App token.
#   The other six overrides (hooks, fsmonitor, sshCommand, pager, editors) stay.
#   Both facts are 0.66's: read from its bundled shell executor and checked by hand
#   on a worker (git 2.39.5). The bats test replays the overrides, not the real
#   shell tool, so the live gate jobs are the end-to-end check, and a Gemini CLI
#   update must re-check them (#172).
#   Limits: --max-turns N becomes model.maxSessionTurns N, which allows N model
#   requests. --max-budget-usd cannot be enforced (the CLI has no spend cap) and
#   --allowed-tools is Claude tool syntax with no Gemini counterpart that matters
#   under yolo approval; each is ignored with one stderr line. `enforces` says
#   so to run-job, which records turns_enforced=yes and budget_enforced=no in
#   the .meta of a job that sets those limits (#173).
#   Exit codes: 2 for a usage error or a session id the CLI would refuse; 3 when
#   the credentials file or the run's Gemini home is unusable, or the checkout
#   would override the job's turn cap, before the CLI starts; otherwise the CLI's own (0 ok, 1 error, 41 auth, 42 input, 44 sandbox,
#   52 config, 53 turn cap, 54 tool, 55 untrusted workspace, 130 cancelled).
#
# normalize
#   From the -o json object on stdout:
#     final_text  .response
#     status      max_turns when .warnings has "Maximum session turns exceeded",
#                 else error when .error is set or .response is missing, else ok
#     is_error    .error is set
#     turns       .stats.tools.totalCalls: tool calls, not model requests
#     tokens_by_model
#                 one entry per .stats.models.<m>.tokens (never .roles, which repeat
#                 them): in = input + tool, cached = cached, cache_write = null (no
#                 write charge on this path), out = candidates, thinking = thoughts.
#                 Disjoint (#173): 0.66 computes input as prompt - cached, so input
#                 excludes cache reads (gate job 211: 175607 - 131671 = 43936);
#                 candidates exclude thoughts; tool (tool-use prompt tokens) is input
#                 outside prompt. A job spans several models (the router, the main
#                 model, the loop detector), and a model called with zero tokens
#                 still has its entry.
#     tokens      tokens_by_model summed field by field.
#     cost_usd    null: the CLI reports no cost (drosera prices the tokens)
#     model       the --model asked for, else null (the CLI's own default)
#   A turn cap reaches the output one of two ways in 0.66. The run loop's own
#   check prints nothing on stdout and the JSON error report (FatalTurnLimitedError)
#   on stderr, and exits 53. The client's check adds the warning above to an
#   otherwise normal stdout object and exits 0. For the first, normalize reads the
#   stderr log run-job keeps beside the raw output (logs/<runid>.stderr next to
#   logs/<runid>.json) and files status max_turns only when that report names the
#   turn cap. Any other run with no JSON on stdout gets no result, and the exit
#   code decides, as the contract says.
#
# transcript
#   Copies the session file Gemini keeps in the run's home,
#   .gemini/tmp/<project>/chats/session-<time>-<first 8 of the id>.jsonl, checked
#   against the full session id on its first line. Subagent sessions (in a
#   directory named after the session) are not copied.
#
# about (#174)
#   lentago/.github ADR-0015's row for Gemini: Gemini CLI, its repository, and the
#   trailer GitHub links to gemini-cli[bot], the App bot google-gemini owns.
#
# live-session (#239)
#   The same file, found the same way while the run is live, printed with the
#   session id: run-job's UUID, which Gemini takes as its own sessionId. run-job
#   links it for the transcript shipper (drosera ADR-0012).
#
# accepts-model
#   gemini-* model ids, and 0.66's aliases: auto, pro, flash, flash-lite and
#   auto-gemini-*. Everything else, every Claude and OpenAI model included, is no.
#
# enforces
#   turns yes (model.maxSessionTurns, above); budget no (the CLI has no spend cap).
#
# update (#172)
#   Brings the npm global @google/gemini-cli under GEMINI_PREFIX (/usr in kalmia's
#   runner image: /usr/bin/gemini, modules under /usr/lib/node_modules, root-owned)
#   to CLAUDE_RUNNER_GEMINI_VERSION from etc/runner.env. That is an exact version,
#   or `latest`; unset leaves the CLI as it is. The install command is the image's
#   own (kalmia forge/runner/substrate.sh), so a worker updated here matches one
#   built at that version. Only an update that is due needs root: a prefix this
#   user cannot write is exit 4. A pin bump is a reviewed PR because this adapter
#   rests on 0.66 facts a new release can change: the shell tool's git overrides
#   (#214), the turn-cap report, the stats shape. Recapture the fixtures and re-run
#   the live gate jobs before bumping. Version checks run with a throwaway HOME,
#   since `gemini --version` writes ~/.gemini, and with stdin from /dev/null.
set -uo pipefail
GEMINI_BIN="${GEMINI_BIN:-/usr/bin/gemini}"
GEMINI_PREFIX="${GEMINI_PREFIX:-/usr}"   # npm --prefix the CLI is installed under (update)
NPM_BIN="${NPM_BIN:-/usr/bin/npm}"
GEMINI_ENV="${CLAUDE_RUNNER_GEMINI_ENV:-/etc/claude-runner/gemini.env}"
KEEP_DAYS=7
CONTEXT_FILES='["GEMINI.md","AGENTS.md","CLAUDE.md"]'
TURN_CAP_WARNING='Maximum session turns exceeded'

usage() { echo "usage: rt-gemini run|normalize|transcript|accepts-model|enforces|update|live-session|about [options]  (see the header)" >&2; exit 2; }
# The per-run Gemini homes, outside any checkout.
state_root() { printf '%s/claytonia/gemini' "${XDG_STATE_HOME:-$HOME/.local/state}"; }
# The CLI's own rule for --session-id; it also keeps the id safe in a path.
valid_sid() { [[ $1 =~ ^[A-Za-z0-9_-]+$ ]]; }
# session_file_of <sid> — the main session file of that run, from the run's own
# home: chats/session-<time>-<first 8 of the id>.jsonl whose first line names the
# full id. Prints nothing when there is none (yet).
session_file_of() {
  local f
  valid_sid "$1" || return 0
  while IFS= read -r f; do
    if [ "$(head -n 1 "$f" 2>/dev/null | jq -r '.sessionId // empty' 2>/dev/null)" = "$1" ]; then
      printf '%s\n' "$f"; return 0
    fi
  done < <(find "$(state_root)/$1/.gemini/tmp" -type f -path '*/chats/session-*' \
             -name "session-*-${1:0:8}.jsonl" 2>/dev/null | sort)
}

cmd="${1:-}"; [ -n "$cmd" ] || usage; shift
cwd=""; sid=""; model=""; max_turns=""; max_budget=""; allowed=""
raw=""; result=""; txt=""; out=""; limit=""
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || { echo "rt-gemini: $1 needs a value" >&2; exit 2; }
  case "$1" in
    --cwd)            cwd="$2" ;;
    --runid)          ;;   # contract input; Gemini gets no .runid sidecar (live transcript: drosera#305)
    --session-id)     sid="$2" ;;
    --model)          model="$2" ;;
    --max-turns)      max_turns="$2" ;;
    --max-budget-usd) max_budget="$2" ;;
    --allowed-tools)  allowed="$2" ;;
    --raw)            raw="$2" ;;
    --result)         result="$2" ;;
    --txt)            txt="$2" ;;
    --out)            out="$2" ;;
    --limit)          limit="$2" ;;
    *) echo "rt-gemini: unknown option $1" >&2; exit 2 ;;
  esac
  shift 2
done

case "$cmd" in
  run)
    valid_sid "$sid" || { echo "rt-gemini: --session-id must be letters, digits, - and _ only" >&2; exit 2; }
    if [ -n "$max_turns" ] && ! [[ $max_turns =~ ^[1-9][0-9]*$ ]]; then
      echo "rt-gemini: --max-turns must be a positive integer" >&2; exit 2
    fi
    # The checkout's settings outrank this run's, so a cap named there would replace
    # the job's own (#205). Fail closed. The keys are read parsed, at any depth, so
    # a JSON-escaped spelling (maxSession\u0054urns) or the legacy top-level key
    # still counts, and the raw text is checked too. A file jq cannot parse (the CLI
    # accepts comments) cannot be checked, so it is refused as well.
    wsset="${cwd:-.}/.gemini/settings.json"
    if [ -n "$max_turns" ] && [ -f "$wsset" ]; then
      why=""
      if ! wskeys="$(jq -r '[paths | .[-1] | strings] | unique[]' "$wsset" 2>/dev/null)"; then
        why="cannot be parsed as JSON, so it cannot be checked for maxSessionTurns"
      elif printf '%s\n' "$wskeys" | grep -qx 'maxSessionTurns' || grep -q 'maxSessionTurns' "$wsset" 2>/dev/null; then
        why="sets maxSessionTurns, which would override this job's max_turns=$max_turns"
      fi
      if [ -n "$why" ]; then
        echo "rt-gemini: the checkout's .gemini/settings.json $why; not running (#205)" >&2
        exit 3
      fi
    fi

    if [ ! -f "$GEMINI_ENV" ] || [ ! -r "$GEMINI_ENV" ]; then
      echo "rt-gemini: cannot read the Gemini credentials file $GEMINI_ENV (installed by hand on the worker; see the rt-gemini header); not running" >&2
      exit 3
    fi
    # Clear any ambient Gemini or Google API key first, so the CLI cannot pick one
    # over the Vertex service account the file selects (review of #204). A key set
    # by the file itself is honored.
    unset GEMINI_API_KEY GOOGLE_API_KEY GOOGLE_GENAI_API_KEY
    # Export everything the file sets. Its stderr is dropped, because a malformed
    # line could echo part of a value; set -u is lifted, because an unset name in
    # the file would otherwise end this script without a word.
    set -a; set +u
    # shellcheck source=/dev/null
    { . "$GEMINI_ENV"; } 2>/dev/null
    set -u; set +a
    if [ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ] && [ ! -r "$GOOGLE_APPLICATION_CREDENTIALS" ]; then
      echo "rt-gemini: GOOGLE_APPLICATION_CREDENTIALS, set in $GEMINI_ENV, does not name a readable file; not running" >&2
      exit 3
    fi
    # No other vendor's credential reaches the Gemini process (#166).
    unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN OPENAI_API_KEY CODEX_API_KEY

    root="$(state_root)"; ghome="$root/$sid"
    find "$root" -mindepth 1 -maxdepth 1 -type d -name '*-*-*-*-*' -mtime +"$KEEP_DAYS" \
      -exec rm -rf -- {} + 2>/dev/null || true
    if ! mkdir -p "$ghome/.gemini" 2>/dev/null \
       || ! jq -n --argjson files "$CONTEXT_FILES" --arg turns "$max_turns" '
            {privacy: {usageStatisticsEnabled: false}, context: {fileName: $files}}
            + (if $turns == "" then {} else {model: {maxSessionTurns: ($turns | tonumber)}} end)' \
            > "$ghome/.gemini/settings.json" 2>/dev/null; then
      echo "rt-gemini: cannot write this run's Gemini settings under $ghome; not running" >&2
      exit 3
    fi

    if [ -n "$max_budget" ]; then
      echo "rt-gemini: max_budget_usd=$max_budget is not enforced: Gemini CLI has no spend cap (turns and the wall clock still bound the run)" >&2
    fi
    if [ -n "$allowed" ]; then
      echo "rt-gemini: allowed_tools is not passed to Gemini: it is Claude tool syntax, and yolo approval already runs every tool" >&2
    fi
    if [ -f "$wsset" ]; then
      echo "rt-gemini: the checkout's .gemini/settings.json overrides this run's Gemini settings (context files); usage statistics stay off through the system settings" >&2
    fi

    # Put the GitHub credential helper back for the agent's git commands (see the
    # header: the shell tool's empty credential.helper would clear it). Same key and
    # scope as ~/.gitconfig, quoted the way `git -c` writes GIT_CONFIG_PARAMETERS.
    helper_key='credential.https://github.com.helper'
    helper="$(git config --global --get "$helper_key" 2>/dev/null)" || helper=""
    if [ -n "$helper" ]; then
      sq="'\\''"
      export GIT_CONFIG_PARAMETERS="${GIT_CONFIG_PARAMETERS:+$GIT_CONFIG_PARAMETERS }'$helper_key'='${helper//\'/$sq}'"
    else
      echo "rt-gemini: no $helper_key in ~/.gitconfig; the agent's git push will have no credential" >&2
    fi

    export GEMINI_CLI_HOME="$ghome" GEMINI_CLI_TRUST_WORKSPACE=true NO_COLOR=1
    args=( -p "" -o json --approval-mode yolo --session-id "$sid" )
    [ -n "$model" ] && args+=( -m "$model" )
    exec "$GEMINI_BIN" "${args[@]}"
    ;;

  normalize)
    [ -n "$raw" ] && [ -n "$result" ] && [ -n "$txt" ] || usage
    rm -f "$result" "$result.tmp" 2>/dev/null
    # Every write below goes through result.tmp: written whole, then moved in place.
    # No result can be written while the output was readable: exit 1, so run-job
    # fails the job rather than file a run it cannot read as a success.
    file_result() {
      if [ -s "$result.tmp" ]; then
        mv -f "$result.tmp" "$result" 2>/dev/null || { rm -f "$result.tmp" 2>/dev/null; exit 1; }
      else
        rm -f "$result.tmp" 2>/dev/null
      fi
    }
    if [ ! -s "$raw" ] || ! jq -e . "$raw" >/dev/null 2>&1; then
      cp "$raw" "$txt" 2>/dev/null || true
      # Nothing on stdout. Only a turn cap the CLI reported on stderr gets a result.
      case "$raw" in
        *.json)
          if grep -qE '"type": "FatalTurnLimitedError"|Reached max session turns for this session' \
               "${raw%.json}.stderr" 2>/dev/null; then
            { jq -n -c --arg model "$model" --arg sid "$sid" '
                {runtime: "gemini", model: (if $model == "" then null else $model end),
                 session_id: (if $sid == "" then null else $sid end),
                 status: "max_turns", is_error: false, turns: null,
                 tokens: {in: null, cached: null, cache_write: null, out: null, thinking: null},
                 tokens_by_model: null, cost_usd: null, final_text: ""}' > "$result.tmp"; } 2>/dev/null \
              || { rm -f "$result.tmp" 2>/dev/null; exit 1; }
            file_result
          fi ;;
      esac
      exit 0
    fi
    # The last JSON value is the result object (0.66 prints exactly one).
    { jq -r -s 'if length == 0 then "" else (last | if type == "object" and (.response | type) == "string"
                then .response else "" end) end' "$raw" > "$txt"; } 2>/dev/null || true
    # Plain jq 1.6 (the workers' Debian 12): every `if` has an `else`. A malformed
    # stats block yields null counts; it must never cost the job its result. The
    # braces keep a failed redirect's shell message off stderr.
    if { jq -c -s --arg model "$model" --arg sid "$sid" --arg cap "$TURN_CAP_WARNING" '
      def num: if type == "number" then . else error("not a number") end;
      def none5: {in: null, cached: null, cache_write: null, out: null, thinking: null};
      def per_model: {in: ((.input | num) + (.tool // 0 | num)), cached: (.cached | num),
                      cache_write: null, out: (.candidates | num), thinking: (.thoughts | num)};
      def by_model: try (.stats.models | if type == "object" and length > 0
                           then with_entries(.value = (.value.tokens | per_model))
                           else error("no models") end) catch null;
      def sum5: {in: (map(.in) | add), cached: (map(.cached) | add), cache_write: null,
                 out: (map(.out) | add), thinking: (map(.thinking) | add)};
      (if $model == "" then null else $model end) as $m
      | (if length == 0 then empty else last end)
      | if type != "object" then
          {runtime: "gemini", model: $m, session_id: (if $sid == "" then null else $sid end),
           status: "error", is_error: false, turns: null,
           tokens: none5, tokens_by_model: null,
           cost_usd: null, final_text: ""}
        else
          ([.warnings[]? | select(. == $cap)] | length > 0) as $capped
          | (.error != null) as $err
          | by_model as $tbm
          | {runtime: "gemini",
             model: $m,
             session_id: (if $sid == "" then .session_id else $sid end),
             status: (if $capped then "max_turns"
                      elif $err or ((.response | type) != "string") then "error"
                      else "ok" end),
             is_error: $err,
             turns: (try (.stats.tools.totalCalls | num) catch null),
             tokens: (if $tbm == null then none5 else ([$tbm[]] | sum5) end),
             tokens_by_model: $tbm,
             cost_usd: null,
             final_text: (if (.response | type) == "string" then .response else "" end)}
        end' "$raw" > "$result.tmp"; } 2>/dev/null
    then
      file_result   # empty output (whitespace only, or a jq that passed it): no result
    else
      rm -f "$result.tmp" 2>/dev/null; exit 1
    fi
    exit 0
    ;;

  accepts-model)
    case "$model" in
      gemini-?*|auto|auto-gemini-?*|pro|flash|flash-lite) exit 0 ;;
      *) exit 1 ;;
    esac
    ;;

  enforces)
    case "$limit" in
      turns)  exit 0 ;;
      budget) exit 1 ;;
      *) usage ;;
    esac
    ;;

  update)
    gemini_version() {
      local h v; h="$(mktemp -d)" || return 1
      v="$(HOME="$h" "$GEMINI_BIN" --version </dev/null 2>/dev/null | head -1)"
      rm -rf "$h"; printf '%s' "$v"
    }
    [ -x "$GEMINI_BIN" ] || { echo "not installed ($GEMINI_BIN)"; exit 3; }
    before="$(gemini_version)"; [ -n "$before" ] || before=unknown
    want="${CLAUDE_RUNNER_GEMINI_VERSION:-}"
    [ -n "$want" ] || { echo "not pinned, left at $before (CLAUDE_RUNNER_GEMINI_VERSION is unset)"; exit 0; }
    [[ $want =~ ^[0-9A-Za-z][0-9A-Za-z.+-]*$ ]] \
      || { echo "update FAILED (was: $before): CLAUDE_RUNNER_GEMINI_VERSION '$want' is not a version"; exit 1; }
    # `latest` (or any npm tag) resolves to a concrete version first.
    target="$want"
    if ! [[ $want =~ ^[0-9]+\.[0-9]+\.[0-9]+([.+-][0-9A-Za-z.+-]*)?$ ]]; then
      target="$("$NPM_BIN" view --no-update-notifier "@google/gemini-cli@${want}" version </dev/null 2>/dev/null | tail -n1)"
      [ -n "$target" ] || { echo "update FAILED (was: $before): npm has no @google/gemini-cli@${want}"; exit 1; }
    fi
    [ "$before" = "$target" ] && { echo "already current ($before)"; exit 0; }
    if [ ! -w "$GEMINI_PREFIX/lib/node_modules" ] || [ ! -w "$GEMINI_PREFIX/bin" ]; then
      echo "needs root: $before -> $target is due, and $GEMINI_PREFIX is not writable by $(id -un)"
      exit 4
    fi
    if ! out="$("$NPM_BIN" install -g --prefix "$GEMINI_PREFIX" --no-fund --no-audit --no-update-notifier \
                  --loglevel=error "@google/gemini-cli@${target}" </dev/null 2>&1)"; then
      echo "update FAILED (was: $before): $(printf '%s' "$out" | tail -1)"
      exit 1
    fi
    after="$(gemini_version)"
    [ "$after" = "$target" ] || { echo "update FAILED (was: $before): installed ${after:-nothing}, wanted $target"; exit 1; }
    echo "updated: $before -> $after"
    exit 0
    ;;

  transcript)
    [ -n "$sid" ] && [ -n "$out" ] || usage
    f="$(session_file_of "$sid")"
    [ -n "$f" ] && cp -f "$f" "$out" 2>/dev/null
    exit 0
    ;;

  about)
    printf '%s\n' '{"name":"Gemini CLI","link":"https://github.com/google-gemini/gemini-cli","trailer":"Co-Authored-By: Gemini CLI <218312386+gemini-cli[bot]@users.noreply.github.com>","trailer_note":""}'
    exit 0
    ;;

  live-session)
    [ -n "$sid" ] || usage
    f="$(session_file_of "$sid")"
    [ -n "$f" ] && printf '%s\t%s\n' "$sid" "$f"
    exit 0
    ;;

  *) usage ;;
esac
