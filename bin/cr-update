#!/usr/bin/env bash
# cr-update — bring every runtime CLI on this worker to its target version, but
# only when no job is running.
#
# Why: the runners are installed with the native installer and nothing else ever
# ran `claude update`, so on 2026-10-03 the fleet sat at 2.1.177–2.1.202 against
# 2.1.289 current. Headless `claude -p` does not self-update. Gemini CLI and Codex
# CLI would likewise stay at whatever the runner image shipped until the next
# rebuild (#172).
#
# What: one step per runtime adapter beside this script (bin/rt-<runtime>), each
# through that adapter's own `update` subcommand, so adding a runtime adds its
# adapter and touches nothing here. Each step logs the CLI's version before and
# after to journald (tag claude-runner). A CLI that is not installed is skipped
# with a line, so a worker built before its image carried that CLI is not an
# error. A step that fails is logged and the others still run; the exit is 1 if
# any step failed. Each step is bounded (CR_UPDATE_STEP_TIMEOUT), because a wedged
# install would hold the inbox lock and stall the worker.
#
# Who: root, from cron (cron/claude-runner). Gemini and Codex are installed
# system-wide and root-owned (kalmia's runner image), and only root can update
# them. Claude Code lives in claude's home, and rt-claude runs its update as
# claude. Run by hand: sudo /opt/claude-runner/bin/cr-update --now. Run as claude
# instead, a step that needs root says so and is skipped.
#
# Versions: Claude Code follows its own release channel (`claude update`). Gemini
# and Codex go to the version etc/runner.env pins for them, so a bump is a
# reviewed one-line PR. Each of those adapters depends on facts about its CLI
# that must be re-checked on a new release (see the rt-gemini and rt-codex
# headers).
#
# How it stays safe: it takes the SAME flock process-inbox holds for the whole of
# a job run (process-inbox exits quietly when it cannot get the lock), so an
# update can never land under a running job, and a job can never start mid-update.
# A random jitter staggers the fleet so five workers do not all update at once.
# The lock file belongs to claude, which process-inbox runs as. Root opens it
# read-only and never with O_CREAT: under fs.protected_regular, a root O_CREAT
# open of another user's file in sticky /tmp fails. And a lock file that root
# created would lock process-inbox out. A missing lock file is therefore created
# exclusively and handed to claude before it is opened.
#
# Every binary is called by absolute path: cron's PATH is /usr/local/bin:/usr/bin:/bin,
# and the native installer puts claude in ~/.local/bin, so a bare `claude` is
# "command not found" under cron (#162).
set -uo pipefail
LOCK="${CLAUDE_INBOX_LOCK:-/tmp/claude-inbox.lock}"
WAIT="${CR_UPDATE_WAIT:-600}"          # seconds to wait for a running job to finish
JITTER="${CR_UPDATE_JITTER:-1800}"     # max random delay before starting (0 with --now)
STEP_TIMEOUT="${CR_UPDATE_STEP_TIMEOUT:-900}"
RUNNER_USER="${CLAUDE_RUNNER_USER:-claude}"
RUNNER_ENV="${CR_UPDATE_RUNNER_ENV:-/opt/claude-runner/etc/runner.env}"   # override: test seam
# The adapters ship beside this script (gitops deploys all of bin/ together).
RT_DIR="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
[ "${1:-}" = "--now" ] && JITTER=0

log() { logger -t claude-runner "cr-update: $*" 2>/dev/null || true; echo "cr-update: $*"; }

# The fleet config, exported, so each adapter's update reads its own version pin.
# shellcheck source=/dev/null
if [ -f "$RUNNER_ENV" ]; then set -a; . "$RUNNER_ENV"; set +a; fi

if [ "$JITTER" -gt 0 ]; then sleep $(( RANDOM % JITTER )); fi

if [ ! -e "$LOCK" ] && ( set -C; : > "$LOCK" ) 2>/dev/null && [ "$(id -u)" -eq 0 ]; then
  chown "$RUNNER_USER:" "$LOCK" 2>/dev/null \
    || { rm -f "$LOCK"; log "cannot hand the new inbox lock to $RUNNER_USER; skipping this run"; exit 1; }
fi
if ! exec 9<"$LOCK"; then
  log "cannot open the inbox lock $LOCK; skipping this run"
  exit 1
fi
if ! flock -w "$WAIT" 9; then
  log "a job is still running after ${WAIT}s; skipping this run"
  exit 0
fi

# One step per adapter. Its update prints one line and exits 0 (updated, or
# already current), 3 (its CLI is not installed), 4 (not this user's to update)
# or anything else (it failed).
rc=0
for adapter in "$RT_DIR"/rt-*; do
  [ -x "$adapter" ] || continue
  name="${adapter##*/rt-}"
  out="$(timeout --kill-after=30 "$STEP_TIMEOUT" "$adapter" update </dev/null 2>&1)"; step=$?
  line="$(printf '%s\n' "$out" | sed '/^[[:space:]]*$/d' | tail -1)"
  case "$step" in
    0)   log "$name: $line" ;;
    3|4) log "$name: skipped, $line" ;;
    124|137) log "$name: update FAILED: no answer in ${STEP_TIMEOUT}s"; rc=1 ;;
    *)   log "$name: ${line:-update FAILED (exit $step)}"; rc=1 ;;
  esac
done
exit "$rc"
