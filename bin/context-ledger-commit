#!/usr/bin/env bash
# context-ledger-commit — sweep the context-ledger incoming queue into the
# PRIVATE ledger repo lentago/myosotis. PRIMARY WORKER ONLY. Runs as root (it
# needs the repo-scoped deploy key at /root/.ssh/myosotis_deploy, which never
# leaves the host). See docs/context-ledger.md.
#
# This pushes DATA COMMITS to a data repo. It NEVER opens or merges a PR and
# NEVER touches a bullpen project — so it does not weaken the fleet's
# branch-and-PR-never-merge boundary.
#
# Primary election: a single NAS marker $LEDGER_ROOT/primary holds the hostname
# of the designated committer. This script self-gates on it (a non-primary that
# somehow has the timer exits 0, silently); provisioning also only enables the
# committer timer on that host. Promotion = write the new hostname to the marker
# and (re)provision so the new host generates its own deploy key.
#
# Test seams (default to production): JOBS_ROOT, LEDGER_REMOTE, LEDGER_CLONE_DIR,
# LEDGER_DEPLOY_KEY, CONTEXT_HOSTNAME, PRIMARY_MARKER.
set -uo pipefail
export LC_ALL=C

sweep_start="$(date +%s)"        # for the context_sweep event's duration_s

JOBS_ROOT="${JOBS_ROOT:-/srv/jobs}"
LEDGER_ROOT="$JOBS_ROOT/context-ledger"
INCOMING="$LEDGER_ROOT/incoming"
PRIMARY_MARKER="${PRIMARY_MARKER:-$LEDGER_ROOT/primary}"
LEDGER_REMOTE="${LEDGER_REMOTE:-git@github.com:lentago/myosotis.git}"
LEDGER_CLONE_DIR="${LEDGER_CLONE_DIR:-/opt/context-ledger/myosotis}"
LEDGER_DEPLOY_KEY="${LEDGER_DEPLOY_KEY:-/root/.ssh/myosotis_deploy}"
HOSTNAME_="${CONTEXT_HOSTNAME:-$(hostname)}"

log(){  echo "context-ledger: $*" | systemd-cat -t claude-runner -p info    2>/dev/null || echo "context-ledger: $*" >&2; }
warn(){ echo "context-ledger: $*" | systemd-cat -t claude-runner -p warning 2>/dev/null || echo "context-ledger: $*" >&2; }
err(){  echo "context-ledger: $*" | systemd-cat -t claude-runner -p err     2>/dev/null || echo "context-ledger: $*" >&2; }

# --- primary gate -------------------------------------------------------------
if [ -f "$PRIMARY_MARKER" ]; then
  want="$(tr -d '[:space:]' < "$PRIMARY_MARKER" 2>/dev/null)"
  if [ "$want" != "$HOSTNAME_" ]; then
    exit 0   # designated primary is elsewhere — silent no-op
  fi
else
  err "no primary marker at $PRIMARY_MARKER — designate a primary (echo <host> > \"$PRIMARY_MARKER\") before enabling the committer"
  exit 1
fi

[ -d "$INCOMING" ] || { log "no incoming queue at $INCOMING — nothing to do"; exit 0; }

# --- deploy key + git identity ------------------------------------------------
# Missing key is the EXPECTED state until the operator finishes the myosotis
# bootstrap: loud error, exit nonzero, incoming stays queued.
if [ ! -f "$LEDGER_DEPLOY_KEY" ]; then
  err "deploy key missing at $LEDGER_DEPLOY_KEY — cannot reach $LEDGER_REMOTE; incoming stays queued (expected until myosotis bootstrap is complete)"
  exit 1
fi
export GIT_SSH_COMMAND="ssh -i $LEDGER_DEPLOY_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
export GIT_AUTHOR_NAME="myosotis-ledger-committer"
export GIT_AUTHOR_EMAIL="myosotis-ledger-committer@claude-runner"
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

command -v rsync >/dev/null 2>&1 || { err "rsync not installed — cannot sweep"; exit 1; }

# --- visibility layer: shared Loki emitter ------------------------------------
# Events are a PROJECTION of the ledger (the source of truth), so a push failure
# must NEVER fail the sweep — every emit is guarded `|| warn`. runner.env carries
# the fleet LOKI_PUSH_URL; cr-loki.sh provides loki_push (+ a URL default). The
# helper lives beside this script; LOKI_LIB is a test seam. See docs.
CONTEXT_STALE_S="${CONTEXT_STALE_S:-93600}"   # 26h: a host quiet longer is "stale"
[ -f /opt/claude-runner/etc/runner.env ] && . /opt/claude-runner/etc/runner.env
LOKI_LIB="${LOKI_LIB:-$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/cr-loki.sh}"
if [ -f "$LOKI_LIB" ]; then
  # shellcheck source=bin/cr-loki.sh
  . "$LOKI_LIB"
else
  warn "loki helper not found at $LOKI_LIB — context events disabled this run"
fi

# --- clone / refresh the ledger repo -----------------------------------------
mkdir -p "$(dirname "$LEDGER_CLONE_DIR")"
if [ ! -d "$LEDGER_CLONE_DIR/.git" ]; then
  rm -rf "$LEDGER_CLONE_DIR"
  if ! git clone --quiet "$LEDGER_REMOTE" "$LEDGER_CLONE_DIR" 2>/dev/null; then
    err "clone of $LEDGER_REMOTE failed (remote missing or key not yet a write deploy key?) — incoming stays queued"
    exit 1
  fi
fi
cd "$LEDGER_CLONE_DIR" || { err "cannot cd $LEDGER_CLONE_DIR"; exit 1; }

if ! git fetch --quiet origin 2>/dev/null; then
  err "git fetch from $LEDGER_REMOTE failed — incoming stays queued"
  exit 1
fi
# Default branch of the remote (fallback: main).
branch="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')"
[ -n "$branch" ] || branch="main"
git checkout --quiet -B "$branch" "origin/$branch" 2>/dev/null || git checkout --quiet "$branch" 2>/dev/null || true
git reset --hard --quiet "origin/$branch" 2>/dev/null || true

# --- sweep incoming/<host> -> hosts/<host>, one commit + push per changed host
# Swept content is INERT DATA: it is only copied and committed, never executed,
# sourced, or templated.
shopt -s nullglob
swept=0; changed=0; quarantined=0
declare -A FILES_CHANGED   # host -> files changed THIS sweep (absent => unswept => 0)
for d in "$INCOMING"/*/; do
  host_dir="${d%/}"
  h="$(basename "$host_dir")"
  case "$h" in *.replacing|*.tmp|*.prev) continue;; esac   # transient staging names
  swept=$((swept+1))

  [ -f "$host_dir/QUARANTINE.txt" ] && { quarantined=$((quarantined+1)); warn "quarantine present for host $h — committing it so the failed snapshot is visible"; }

  dest="hosts/$h"
  mkdir -p "$dest"
  # Guard the copy: under `set +e` a partial rsync would otherwise be committed
  # as if complete. Skip the host; its incoming stays queued for the next run.
  if ! rsync -a --delete "$host_dir/" "$dest/"; then
    err "rsync failed for host $h — skipping; incoming stays queued"
    git checkout --quiet -- "$dest" 2>/dev/null || true
    git clean --quiet -fd -- "$dest" 2>/dev/null || true
    continue
  fi

  git add -A -- "$dest"
  if git diff --cached --quiet -- "$dest"; then
    # No change vs what is already in the ledger — safe to drop the incoming copy.
    rm -rf "$host_dir"
    continue
  fi

  n="$(git diff --cached --numstat -- "$dest" | wc -l | tr -d ' ')"
  git commit --quiet -m "ledger($h): $n files changed"
  # Default git push is fast-forward-only; we NEVER pass --force.
  if git push --quiet origin "$branch" 2>/dev/null; then
    rm -rf "$host_dir"   # delete swept incoming ONLY after the push lands
    changed=$((changed+1))
    FILES_CHANGED[$h]="$n"
  else
    err "push failed for host $h — leaving incoming queued; local commit will be re-derived next run"
    # Leave incoming in place. Next run resets to origin/$branch (dropping this
    # unpushed commit) and re-derives it from the still-queued incoming dir.
  fi
done

# --- visibility events: context_sweep + one context_host per host -------------
# A PROJECTION of the ledger for Grafana/drosera dashboards + liveness alerting.
# The emitted JSON is a cross-repo CONTRACT — see docs/context-ledger.md § Events
# and treat field changes as breaking. Sizes/counts are derived from the
# committed tree, so the snapshot side needs no changes. Pushes are guarded so a
# Loki failure NEVER fails the sweep.

# host_tree_bytes <host-dir> -> total bytes of every regular file under it.
host_tree_bytes() {
  local dir="$1" total=0 b f
  while IFS= read -r f; do
    b="$(stat -c %s "$f" 2>/dev/null || echo 0)"
    total=$((total + b))
  done < <(find "$dir" -type f 2>/dev/null)
  echo "$total"
}

# host_memory_stats <host-dir> -> "<files> <bytes>" for per-project memory.
# full mode (workers) copies bodies under claude/projects/*/memory/**; hash mode
# (the operator workstation) emits only claude/projects/*/memory.manifest whose
# 3rd TAB column is bytes. Count both so every host reports real memory sizes.
host_memory_stats() {
  local dir="$1" files=0 bytes=0 b rel f mf
  local projroot="$dir/claude/projects"
  while IFS= read -r f; do
    files=$((files + 1))
    b="$(stat -c %s "$f" 2>/dev/null || echo 0)"
    bytes=$((bytes + b))
  done < <(find "$projroot" -type f -path '*/memory/*' 2>/dev/null)
  while IFS= read -r mf; do
    # manifest columns: relpath \t sha256 \t bytes \t mtime — need rel + bytes.
    while IFS=$'\t' read -r rel _ b _; do
      [ -n "$rel" ] || continue
      case "$b" in ''|*[!0-9]*) b=0 ;; esac
      files=$((files + 1))
      bytes=$((bytes + b))
    done < "$mf"
  done < <(find "$projroot" -type f -name memory.manifest 2>/dev/null)
  echo "$files $bytes"
}

emit_events() {
  command -v loki_push >/dev/null 2>&1 || return 0   # helper absent (already warned)
  local now; now="$(date +%s)"

  # 1) One context_sweep event for the whole run.
  local sweep_labels sweep_line
  sweep_labels="$(jq -cn '{job:"claude_runner", service:"context_ledger"}')"
  sweep_line="$(jq -cn --arg sw "$swept" --arg ch "$changed" --arg q "$quarantined" \
    --arg dur "$((now - sweep_start))" \
    '{event:"context_sweep", swept:($sw|tonumber), changed:($ch|tonumber),
      quarantined:($q|tonumber), duration_s:($dur|tonumber)}')"
  loki_push "$sweep_labels" "$sweep_line" || warn "context_sweep event push failed (sweep unaffected)"

  # 2) One context_host event per host dir in the clone — NOT just swept hosts,
  #    so a host absent from incoming/ still reports its age (liveness alerting).
  local hd h meta ts_utc ts_epoch age cv mm mstatus status fc commit
  local total_bytes mem_files mem_bytes skills_count labels line
  for hd in hosts/*/; do
    [ -d "$hd" ] || continue
    hd="${hd%/}"
    h="$(basename "$hd")"
    meta="$hd/meta.json"

    ts_utc=""; cv=""; mm=""; mstatus="ok"
    if [ -f "$meta" ]; then
      ts_utc="$(jq -r '.timestamp_utc // empty' "$meta" 2>/dev/null)"
      cv="$(jq -r '.claude_version // empty'  "$meta" 2>/dev/null)"
      mm="$(jq -r '.memory_mode // empty'     "$meta" 2>/dev/null)"
      mstatus="$(jq -r '.status // "ok"'      "$meta" 2>/dev/null)"
    fi

    # snapshot_age_s = now - meta.timestamp_utc (null if unparseable/absent).
    age=""
    if [ -n "$ts_utc" ]; then
      ts_epoch="$(date -u -d "$ts_utc" +%s 2>/dev/null || true)"
      [ -n "$ts_epoch" ] && age="$((now - ts_epoch))"
    fi

    # status: a quarantined slot (guard hit, committed for visibility) wins; else
    # stale when the snapshot has aged past CONTEXT_STALE_S; else ok.
    if [ -f "$hd/QUARANTINE.txt" ] || [ "$mstatus" = quarantined ]; then
      status="quarantined"
    elif [ -n "$age" ] && [ "$age" -gt "$CONTEXT_STALE_S" ]; then
      status="stale"
    else
      status="ok"
    fi

    fc="${FILES_CHANGED[$h]:-0}"
    commit="$(git log -1 --format=%h -- "$hd" 2>/dev/null || true)"
    total_bytes="$(host_tree_bytes "$hd")"
    read -r mem_files mem_bytes <<<"$(host_memory_stats "$hd")"
    skills_count="$(find "$hd/claude/skills" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"

    labels="$(jq -cn --arg host "$h" \
      '{job:"claude_runner", service:"context_ledger", host:$host}')"
    line="$(jq -cn --arg host "$h" --arg status "$status" --arg fc "$fc" \
      --arg commit "$commit" --arg age "$age" --arg cv "$cv" --arg mm "$mm" \
      --arg tb "$total_bytes" --arg mb "$mem_bytes" --arg mf "$mem_files" --arg sc "$skills_count" \
      '{event:"context_host", host:$host, status:$status,
        files_changed:($fc|tonumber? // 0), commit:$commit,
        snapshot_age_s:(($age|tonumber?) // null),
        claude_version:$cv, memory_mode:$mm,
        total_bytes:($tb|tonumber? // 0), memory_bytes:($mb|tonumber? // 0),
        memory_files:($mf|tonumber? // 0), skills_count:($sc|tonumber? // 0)}')"
    loki_push "$labels" "$line" || warn "context_host event push failed for $h (sweep unaffected)"
  done
  return 0
}

emit_events

log "swept=$swept changed=$changed quarantined=$quarantined"
