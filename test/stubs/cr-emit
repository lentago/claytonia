#!/usr/bin/env bash
# Stub `cr-emit` for the queue-core test harness — the real one POSTs metrics to
# Loki. Tests exercise the queue mechanics, not telemetry, so this is a no-op.
# FAKE_CREMIT_LOG, if set, gets one line per call (argv, tab-separated) so a test
# can assert what run-job hands the emitter (e.g. the submitter field, #21).
[ -n "${FAKE_CREMIT_LOG:-}" ] && { (IFS=$'\t'; printf '%s\n' "$*") >> "$FAKE_CREMIT_LOG"; }
exit 0
