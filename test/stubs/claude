#!/usr/bin/env bash
# Stub `claude` for the queue-core test harness. Consumes the prompt on stdin
# (as the real headless `claude -p` does) and prints a result JSON in the same
# shape run-job parses (.result / .is_error / .total_cost_usd / .num_turns).
# Behaviour is picked by FAKE_CLAUDE_MODE so tests can drive done vs failed:
#   ok      -> valid success JSON, exit 0                (routes to done/)
#   error   -> valid JSON with is_error=true, exit 0     (run-job sets rc=1 -> failed/)
#   nonzero -> non-JSON on stdout, exit 9                (rc=9 -> failed/)
#   turns   -> subtype error_max_turns, is_error=false   (limit=turns -> failed/)
#   budget  -> subtype error_max_budget_usd              (limit=budget -> failed/)
# A prompt containing FAKE_HANG sleeps FAKE_CLAUDE_SLEEP (default 60) seconds
# first, so one job in a batch can blow its timeout while the rest run normally.
# FAKE_CLAUDE_ARGS, if set, receives the argv (one per line) for assertions.
set -u
prompt="$(cat 2>/dev/null)" || true   # drain the piped prompt; never fail on a closed pipe
[ -n "${FAKE_CLAUDE_ARGS:-}" ] && printf '%s\n' "$@" > "$FAKE_CLAUDE_ARGS"
case "$prompt" in *FAKE_HANG*) sleep "${FAKE_CLAUDE_SLEEP:-60}" ;; esac

case "${FAKE_CLAUDE_MODE:-ok}" in
  error)
    printf '{"result":"stub failure","is_error":true,"total_cost_usd":0,"num_turns":1}\n'
    exit 0
    ;;
  nonzero)
    printf 'stub crashed before emitting JSON\n'
    exit 9
    ;;
  turns)
    printf '{"subtype":"error_max_turns","is_error":false,"total_cost_usd":0.5,"num_turns":4}\n'
    exit 0
    ;;
  budget)
    printf '{"subtype":"error_max_budget_usd","is_error":true,"total_cost_usd":2.01,"num_turns":9}\n'
    exit 0
    ;;
  *)
    printf '{"result":"stub ok","is_error":false,"total_cost_usd":0.0001,"num_turns":1}\n'
    exit 0
    ;;
esac
