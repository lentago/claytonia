#!/usr/bin/env bash
# Stub `gh`: records every call (argv, one line per call) to FAKE_GH_LOG and
# answers `api` calls. FAKE_GH_FAIL=1 makes `api` exit 1; FAKE_GH_SLEEP=N hangs it.
# Comment creation (POST .../comments) prints the id 4242 (what --jq .id yields).
# PATCH bodies are appended to FAKE_GH_BODIES, separated by a NUL-free marker line.
# For cr-submit's overlap check (#22): when FAKE_GH_PRS names a file, `pr list` prints
# it (FAIL/SLEEP apply), and `api .../pulls/<n>/files` prints FAKE_GH_FILES_DIR/<n>.json.
# For run-job's PR footer (#174): `api .../pulls/<n>` prints the PR JSON object
# (body from FAKE_GH_PR_BODY or FAKE_GH_PR_JSON, head from FAKE_GH_PR_HEAD or agent/feat,
# author from FAKE_GH_PR_AUTHOR or lentago-claude-runner[bot], created_at from
# FAKE_GH_PR_CREATED or now; an author or created_at set empty is sent empty), and
# `api -X PATCH .../pulls/<n> -f body=...` writes that body to FAKE_GH_PATCHED.
# FAKE_GH_STDERR, if set, is written to stderr by every call, as a gh warning would be.
set -u
[ -n "${FAKE_GH_LOG:-}" ] && printf '%s\n' "$*" >> "$FAKE_GH_LOG"
[ -n "${FAKE_GH_STDERR:-}" ] && printf '%s\n' "$FAKE_GH_STDERR" >&2
if [ "${1:-} ${2:-}" = "pr list" ] && [ -n "${FAKE_GH_PRS:-}" ]; then
  [ -n "${FAKE_GH_SLEEP:-}" ] && sleep "$FAKE_GH_SLEEP"
  [ "${FAKE_GH_FAIL:-0}" = 1 ] && { echo "gh: HTTP 500" >&2; exit 1; }
  cat "$FAKE_GH_PRS"; exit 0
fi
[ "${1:-}" = api ] || exit 0
[ -n "${FAKE_GH_SLEEP:-}" ] && sleep "$FAKE_GH_SLEEP"
[ "${FAKE_GH_FAIL:-0}" = 1 ] && { echo "gh: HTTP 500" >&2; exit 1; }
case "${2:-}" in
  */pulls/*/files*)
    _n="${2#*/pulls/}"; _n="${_n%%/*}"
    cat "${FAKE_GH_FILES_DIR:-/nonexistent}/$_n.json" 2>/dev/null || { echo "gh: HTTP 404" >&2; exit 1; }
    exit 0 ;;
  */pulls/[0-9]*)
    if [ -n "${FAKE_GH_PR_JSON:-}" ] && [ -f "${FAKE_GH_PR_JSON:-}" ]; then
      cat "$FAKE_GH_PR_JSON"; exit 0
    fi
    _b="$(cat "${FAKE_GH_PR_BODY:-/dev/null}")"
    jq -cn --arg b "$_b" \
      --arg head "${FAKE_GH_PR_HEAD:-agent/feat}" \
      --arg author "${FAKE_GH_PR_AUTHOR-lentago-claude-runner[bot]}" \
      --arg created "${FAKE_GH_PR_CREATED-$(date -u +%FT%TZ)}" \
      '{body: $b, head: {ref: $head}, user: {login: $author}, created_at: $created}'
    exit 0 ;;
esac
if [ "${2:-} ${3:-}" = "-X PATCH" ]; then
  case "${4:-}" in
    */pulls/[0-9]*)
      for _a in "$@"; do case "$_a" in body=*) printf '%s' "${_a#body=}" > "${FAKE_GH_PATCHED:-/dev/null}" ;; esac; done
      exit 0 ;;
  esac
fi
case " $* " in *" PATCH "*) ;; *) echo 4242 ;; esac
exit 0
